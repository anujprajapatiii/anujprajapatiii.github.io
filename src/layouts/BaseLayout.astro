---
import "../styles/global.css";
import { siteConfig } from "@/data/site-config";
import { defaultPagePalette, type PagePalette } from "@/data/page-palettes";
/* TASA Orbiter (SIL OFL) is one variable face for all readable type below the
   display step. One preload covers the 400/500/600 hierarchy without fetching
   separate files. */
import tasaOrbiter from "../assets/fonts/tasa-orbiter-variable.woff2?url";
/* Violet Sans (SIL OFL) carries the display step. Its preload is opt-in below:
   CSS still loads the face wherever it is used, while routes without display
   type avoid eagerly fetching a font they never render. */
import violetSans from "../assets/fonts/violet-sans-regular.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  palette?: PagePalette;
  preloadDisplayFont?: boolean;
}

const {
  title,
  description,
  image,
  noindex = false,
  palette = defaultPagePalette,
  preloadDisplayFont = false,
} = Astro.props;

const pageTitle = title ?? siteConfig.title;
const pageDescription = description ?? siteConfig.description;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImage = image ? new URL(image, siteConfig.url).toString() : undefined;
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    {/* TASA is universal. Violet is preloaded only on routes that render display type. */}
    <link rel="preload" href={tasaOrbiter} as="font" type="font/woff2" crossorigin />
    {preloadDisplayFont && (
      <link rel="preload" href={violetSans} as="font" type="font/woff2" crossorigin />
    )}
    <title>{pageTitle}</title>

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter Card */}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/*
      Prevent flash of wrong theme: runs before paint. Storage is tri-state —
      "light", "dark", or absent, where absent means "follow the OS". Anything
      else is treated as absent so a stale or hand-edited key cannot strand
      the site on a theme. This class also selects the toggle's icon, so the
      right one is painted too. See ThemeToggle.astro.
    */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        if (theme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
