---
import "../styles/global.css";
import { siteConfig } from "@/data/site-config";
import { defaultPagePalette, type PagePalette } from "@/data/page-palettes";
/* KMR Apparat is self-hosted under the purchased Web License. These imports
   point to Kimera's original, unchanged WOFF2 files and must stay aligned with
   the @font-face URLs in global.css. */
import apparatLight from "../assets/fonts/kmr-apparat-light.woff2?url";
import apparatRegular from "../assets/fonts/kmr-apparat-regular.woff2?url";
import apparatMedium from "../assets/fonts/kmr-apparat-medium.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  palette?: PagePalette;
}

const {
  title,
  description,
  image,
  noindex = false,
  palette = defaultPagePalette,
} = Astro.props;

const pageTitle = title ?? siteConfig.title;
const pageDescription = description ?? siteConfig.description;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImage = image ? new URL(image, siteConfig.url).toString() : undefined;
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    {/* Standard pages use all three authored Apparat roles above the fold. */}
    <link rel="preload" href={apparatLight} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={apparatRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={apparatMedium} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter Card */}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/*
      Prevent flash of wrong theme: runs before paint. Storage is tri-state —
      "light", "dark", or absent, where absent means "follow the OS". Anything
      else is treated as absent so a stale or hand-edited key cannot strand
      the site on a theme. This class also selects the toggle's icon, so the
      right one is painted too. See ThemeToggle.astro.
    */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        if (theme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
