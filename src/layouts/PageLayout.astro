---
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import type { PagePalette } from "@/data/page-palettes";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  palette?: PagePalette;
  preloadDisplayFont?: boolean;
}

const { title, description, image, noindex, palette, preloadDisplayFont } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  noindex={noindex}
  palette={palette}
  preloadDisplayFont={preloadDisplayFont}
>
  <div class="flex min-h-dvh flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
