---
import "./sunlit-hero-scene.css";

/*
  Hero-local translation of the Sunlit reference. The static foliage texture
  keeps the costly displacement effect out of the runtime and can be swapped
  without changing the scene composition.
*/
const shutters = Array.from({ length: 23 });
---

<div
  class="sunlit-hero-overlay"
  data-sunlit-hero
  aria-hidden="true"
>
  <div class="sunlit-hero-overlay__glow"></div>
  <div class="sunlit-hero-overlay__glow-bounce"></div>

  <div class="sunlit-hero-overlay__perspective">
    <div class="sunlit-hero-overlay__leaves"></div>

    <div class="sunlit-hero-overlay__blinds">
      <div class="sunlit-hero-overlay__shutters">
        {shutters.map(() => <div class="sunlit-hero-overlay__shutter"></div>)}
      </div>
      <div class="sunlit-hero-overlay__vertical">
        <div class="sunlit-hero-overlay__bar"></div>
        <div class="sunlit-hero-overlay__bar"></div>
      </div>
    </div>
  </div>

  <div class="sunlit-hero-overlay__progressive-blur">
    <div></div>
    <div></div>
  </div>
</div>

<script>
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const sceneVisibility = new WeakMap<HTMLElement, boolean>();

  function setSunlitActivity(scene: HTMLElement, isVisible: boolean) {
    sceneVisibility.set(scene, isVisible);
    const isActive = isVisible && !document.hidden && !motionPreference.matches;
    scene.toggleAttribute("data-sunlit-active", isActive);
  }

  const observer = "IntersectionObserver" in window
    ? new IntersectionObserver((entries) => {
        for (const entry of entries) {
          setSunlitActivity(entry.target as HTMLElement, entry.isIntersecting);
        }
      }, { rootMargin: "10% 0px" })
    : null;

  function observeSunlitScenes() {
    document.querySelectorAll<HTMLElement>("[data-sunlit-hero]").forEach((scene) => {
      if (scene.dataset.sunlitObserved) return;
      scene.dataset.sunlitObserved = "true";
      sceneVisibility.set(scene, true);
      setSunlitActivity(scene, true);
      observer?.observe(scene);
    });
  }

  function syncSunlitScenes() {
    document.querySelectorAll<HTMLElement>("[data-sunlit-hero]").forEach((scene) => {
      setSunlitActivity(scene, sceneVisibility.get(scene) ?? true);
    });
  }

  function releaseSunlitScenes() {
    document.querySelectorAll<HTMLElement>("[data-sunlit-hero]").forEach((scene) => {
      observer?.unobserve(scene);
      sceneVisibility.delete(scene);
    });
  }

  motionPreference.addEventListener("change", syncSunlitScenes);
  document.addEventListener("visibilitychange", syncSunlitScenes);

  observeSunlitScenes();
  document.addEventListener("astro:before-swap", releaseSunlitScenes);
  document.addEventListener("astro:after-swap", observeSunlitScenes);
</script>
