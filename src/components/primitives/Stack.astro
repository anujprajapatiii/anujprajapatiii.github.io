---
/* Vertical flex with consistent gap. See global.css "Layout primitives". */
interface Props {
  gap?: "sm" | "md" | "lg";
  as?: string;
  class?: string;
}
const { gap = "md", as = "div", class: className } = Astro.props;
const Tag = as as any;
---

<Tag class:list={["stack", `stack--${gap}`, className]}>
  <slot />
</Tag>
