---
/* Vertical flex with consistent gap. See global.css "Layout primitives". */
interface Props {
  [key: string]: unknown;
  gap?: "2xs" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
  as?: string;
  class?: string;
}
const { gap = "sm", as = "div", class: className, ...attrs } = Astro.props;
const Tag = as as any;
---

<Tag {...attrs} class:list={["stack", `stack--${gap}`, className]}>
  <slot />
</Tag>
