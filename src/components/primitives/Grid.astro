---
/* The site's 24-track structural grid. Children set spans with GridItem. */
interface Props {
  [key: string]: unknown;
  as?: string;
  class?: string;
}
const { as = "div", class: className, ...attrs } = Astro.props;
const Tag = as as any;
---

<Tag {...attrs} class:list={["layout-grid", className]}>
  <slot />
</Tag>
