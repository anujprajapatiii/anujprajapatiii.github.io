---
/*
  Two-column layout: a fixed-width rail and a flexible content column.
  Collapses to a single column when the content column would drop below the
  reading measure. See global.css "Layout primitives" for the widths and the
  measured breakpoint.

  The rail is the first child; content is the second. If the rail renders
  nothing, the grid stays single-column rather than leaving an empty gutter.
*/
interface Props {
  as?: string;
  class?: string;
}
const { as = "div", class: className } = Astro.props;
const Tag = as as any;
---

<Tag class:list={["sidebar-layout", className]}>
  <slot />
</Tag>
