---
/*
  The page container: 1024px, centred, with the gutter. One width for the
  whole site — header, footer and every page — so everything sits on the same
  two vertical edges. There is no size prop by design; a second container
  width is how a layout starts drifting.

  For capping long-form text, use `max-w-measure` (~70 characters). That is a
  reading measure, not a container. See global.css.
*/
interface Props {
  as?: string;
  class?: string;
}
const { as = "div", class: className } = Astro.props;
const Tag = as as any;
---

<Tag class:list={["container", className]}>
  <slot />
</Tag>
