---
/* Max-width + center + horizontal gutter. See global.css "Layout primitives". */
interface Props {
  size?: "narrow" | "content" | "wide";
  as?: string;
  class?: string;
}
const { size = "wide", as = "div", class: className } = Astro.props;
const Tag = as as any;
---

<Tag class:list={["container", `container--${size}`, className]}>
  <slot />
</Tag>
