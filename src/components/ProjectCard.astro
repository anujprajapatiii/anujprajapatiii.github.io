---
/*
  The card shows title, year and description only. Role lives on the case
  study itself, in the Role/Year/Skills metadata — repeating it here as a
  subtitle added a third text block to a card that only needs two.

  Spacing comes from the named scale, never raw Tailwind steps: `p-card` is
  the semantic role for card interior padding.
*/
interface Props {
  id: string;
  title: string;
  description: string;
  year?: string;
  thumbnail?: string;
  base?: string;
}

const { id, title, description, year, thumbnail, base = "/work" } = Astro.props;
---

<a
  href={`${base}/${id}`}
  class="group block border border-border bg-card p-card transition-colors hover:border-border-hover"
>
  {thumbnail ? (
    <img
      src={thumbnail}
      alt=""
      loading="lazy"
      class="mb-sm aspect-[16/10] w-full border border-border object-cover"
    />
  ) : (
    <div class="media-placeholder mb-sm"></div>
  )}
  <div class="flex items-baseline justify-between gap-sm">
    <h3 class="text-h3 transition-colors group-hover:text-accent">
      {title}
    </h3>
    {year && (
      <span class="shrink-0 text-small tabular-nums text-muted-foreground">{year}</span>
    )}
  </div>
  <p class="mt-xs text-small text-muted-foreground">{description}</p>
</a>
