---
interface Props {
  id: string;
  title: string;
  description: string;
  thumbnail?: string;
  base?: string;
}

const { id, title, description, thumbnail, base = "/work" } = Astro.props;
const isExperiment = base === "/play";
const ctaLabel = isExperiment ? "View experiment" : "View case study";
---

<article class="project-card">
  <div class="project-card__content">
    <div>
      <h3 class="text-body">{title}</h3>
      <p class="project-card__meta mt-2xs text-body">{description}</p>
    </div>
    <a
      href={`${base}/${id}`}
      class="project-card__link text-body"
      aria-label={`${ctaLabel}: ${title}`}
    >
      {ctaLabel}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
  {thumbnail ? (
    <img
      src={thumbnail}
      alt=""
      loading="lazy"
      class="project-card__media"
    />
  ) : (
    <div class="media-placeholder project-card__media"></div>
  )}
</article>
