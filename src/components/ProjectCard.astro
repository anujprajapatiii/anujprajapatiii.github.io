---
interface Props {
  id: string;
  title: string;
  description: string;
  thumbnail?: string;
  base?: string;
  headingLevel?: "h2" | "h3" | "h4";
}

const {
  id,
  title,
  description,
  thumbnail,
  base = "/work",
  headingLevel = "h3",
} = Astro.props;
const titleId = `project-card-title-${base === "/play" ? "play" : "work"}-${id}`;
const Heading = headingLevel;
---

<article class="project-card">
  <a
    href={`${base}/${id}`}
    class="project-card__link"
    aria-labelledby={titleId}
  >
    <div class="project-card__content">
      <Heading id={titleId} class="project-card__title">
        {title}
      </Heading>
      <p class="project-card__meta mt-3xs text-body">{description}</p>
    </div>
    {thumbnail ? (
      <img
        src={thumbnail}
        alt=""
        loading="lazy"
        class="project-card__media"
      />
    ) : (
      <div class="media-placeholder project-card__media"></div>
    )}
  </a>
</article>
