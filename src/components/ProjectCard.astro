---
interface Props {
  id: string;
  title: string;
  description: string;
  thumbnail?: string;
  base?: string;
}

const { id, title, description, thumbnail, base = "/work" } = Astro.props;
const titleId = `project-card-title-${base === "/play" ? "play" : "work"}-${id}`;
---

<article class="project-card">
  <a
    href={`${base}/${id}`}
    class="project-card__link"
    aria-labelledby={titleId}
  >
    <div class="project-card__content">
      <h3 id={titleId} class="project-card__title">
        {title}<span class="card-title__arrow" aria-hidden="true">&rarr;</span>
      </h3>
      <p class="project-card__meta mt-2xs text-body">{description}</p>
    </div>
    {thumbnail ? (
      <img
        src={thumbnail}
        alt=""
        loading="lazy"
        class="project-card__media"
      />
    ) : (
      <div class="media-placeholder project-card__media"></div>
    )}
  </a>
</article>
