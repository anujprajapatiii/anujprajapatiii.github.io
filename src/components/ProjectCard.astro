---
/*
  The card shows title, year and description only. Role lives on the case
  study itself, in the Role/Year/Skills metadata — repeating it here as a
  subtitle added a third text block to a card that only needs two.

  Spacing comes from the named scale, never raw Tailwind steps: `p-card` is
  the semantic role for card interior padding.
*/
interface Props {
  id: string;
  title: string;
  description: string;
  year?: string;
  thumbnail?: string;
  base?: string;
}

const { id, title, description, year, thumbnail, base = "/work" } = Astro.props;
---

{/*
  `.project-card` is named in the INTERACTION block in global.css: surface,
  rule and text all lift together from there, and the thumbnail's frame moves
  with the card's. No group modifier, no hover utility and no colour-transition
  utility here — the card used to move its border and its title while its
  surface, its year and its description stood still, so it came forward in
  pieces. (Class names are described rather than spelled: Tailwind scans
  comments in src/, so writing one out would re-generate the rule.)

  `.project-card__meta` marks the two elements that rest quiet and come up with
  the card, so the whole thing reads as one object.
*/}
<a href={`${base}/${id}`} class="project-card block p-card">
  {thumbnail ? (
    <img
      src={thumbnail}
      alt=""
      loading="lazy"
      class="mb-sm aspect-[16/10] w-full border border-border object-cover"
    />
  ) : (
    <div class="media-placeholder mb-sm"></div>
  )}
  <div class="flex items-baseline justify-between gap-sm">
    <h3 class="text-h3">
      {title}
    </h3>
    {year && (
      <span class="project-card__meta shrink-0 text-small tabular-nums">{year}</span>
    )}
  </div>
  <p class="project-card__meta mt-xs text-small">{description}</p>
</a>
