---
import { siteConfig } from "@/data/site-config";
import Container from "@/components/primitives/Container.astro";
import Cluster from "@/components/primitives/Cluster.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <Cluster justify="between" gap="md">
      <p class="text-small text-muted-foreground">
        © {year} {siteConfig.name}
      </p>
      <Cluster as="nav" gap="lg" class="text-small" aria-label="Footer links">
        {/*
          The style guide is an internal reference, not a social profile, so
          it is not in siteConfig.social and it stays first — an internal link
          before the ones that leave the site. It is `noindex`; the footer is
          how it is found at all.
        */}
        <a
          href="/style-guide"
          class="text-muted-foreground transition-colors hover:text-accent"
        >Style guide</a>
        {siteConfig.social.github && (
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground transition-colors hover:text-accent"
          >GitHub</a>
        )}
        {siteConfig.social.linkedin && (
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground transition-colors hover:text-accent"
          >LinkedIn</a>
        )}
        {siteConfig.social.email && (
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="text-muted-foreground transition-colors hover:text-accent"
          >Email</a>
        )}
      </Cluster>
    </Cluster>
  </Container>
</footer>
