---
import { siteConfig } from "@/data/site-config";
import ThemeToggle from "./ThemeToggle.astro";
import Container from "@/components/primitives/Container.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string) {
  const path = href.split("#")[0];
  if (!path || path === "/") return false;
  return currentPath === path || currentPath.startsWith(`${path}/`);
}
---

<header class="site-header">
  <Container>
    <Grid>
      <GridItem>
        <div class="site-nav">
          <a href="/" class="wordmark site-hit-target">
            {siteConfig.name}
          </a>

          <div class="site-nav__end">
            <nav class="site-nav__links" aria-label="Main navigation">
              {siteConfig.nav.map((item) => (
                <a
                  href={item.href}
                  class="site-hit-target"
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))}
            </nav>
            <div class="site-nav__toggle"><ThemeToggle /></div>
          </div>
        </div>
      </GridItem>
    </Grid>
  </Container>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");

  if (header) {
    const syncDivider = () => {
      header.toggleAttribute("data-scrolled", window.scrollY > 8);
    };

    syncDivider();
    window.addEventListener("scroll", syncDivider, { passive: true });
  }
</script>
