---
import { siteConfig } from "@/data/site-config";
import ThemeToggle from "./ThemeToggle.astro";
import Container from "@/components/primitives/Container.astro";
import Cluster from "@/components/primitives/Cluster.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string) {
  const path = href.split("#")[0];
  if (!path || path === "/") return false;
  return currentPath === path || currentPath.startsWith(`${path}/`);
}
---

<header class="site-header">
  <Container size="wide">
    <Cluster justify="between" align="center">
      <a href="/" class="wordmark transition-colors hover:text-accent">
        {siteConfig.name}
      </a>
      <Cluster as="nav" gap="md" class="text-sm">
        {siteConfig.nav.map((item, i) => (
          <>
            {i > 0 && <span class="nav-pipe" aria-hidden="true"></span>}
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            >
              {item.label}
            </a>
          </>
        ))}
        <span class="nav-pipe" aria-hidden="true"></span>
        <ThemeToggle />
      </Cluster>
    </Cluster>
  </Container>
</header>
