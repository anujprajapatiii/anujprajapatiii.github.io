---
import { siteConfig } from "@/data/site-config";
import ThemeToggle from "./ThemeToggle.astro";
import Container from "@/components/primitives/Container.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string) {
  const path = href.split("#")[0];
  if (!path || path === "/") return false;
  return currentPath === path || currentPath.startsWith(`${path}/`);
}
---

<header class="site-header">
  <Container size="wide">
    {/* Custom responsive header bar: on wide screens the nav + toggle group
        to the right; below --bp-md the nav wraps to its own row and the
        toggle stays pinned to the right edge. See global.css .site-nav. */}
    <div class="site-nav">
      <a href="/" class="wordmark transition-colors hover:text-accent">
        {siteConfig.name}
      </a>
      <nav class="site-nav__links" aria-label="Main navigation">
        {siteConfig.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="text-muted-foreground transition-colors hover:text-accent aria-[current=page]:text-foreground"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="site-nav__toggle"><ThemeToggle /></div>
    </div>
  </Container>
</header>
