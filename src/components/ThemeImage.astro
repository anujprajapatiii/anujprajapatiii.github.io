---
interface Props {
  lightSrc: string;
  darkSrc?: string;
  alt?: string;
  class?: string;
}

const {
  lightSrc,
  darkSrc,
  alt = "",
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "theme-image",
    darkSrc && "theme-image--switchable",
    className,
  ]}
>
  <img
    src={lightSrc}
    alt={alt}
    class="theme-image__light"
    decoding="async"
  />
  {darkSrc && (
    <img
      src={darkSrc}
      alt={alt}
      class="theme-image__dark"
      decoding="async"
    />
  )}
</div>

<style>
  .theme-image {
    display: block;
    width: 100%;
  }

  .theme-image > img {
    display: block;
    width: 100%;
    height: auto;
  }

  .theme-image--cover {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .theme-image--cover > img {
    height: 100%;
    object-fit: cover;
  }

  .theme-image > .theme-image__dark {
    display: none;
  }

  :global(.dark) .theme-image--switchable > .theme-image__light {
    display: none;
  }

  :global(.dark) .theme-image--switchable > .theme-image__dark {
    display: block;
  }
</style>
