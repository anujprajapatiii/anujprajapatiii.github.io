---
import ThemeImage from "@/components/ThemeImage.astro";

/*
  Homepage Experiments has two levels of state: a selected experiment row and
  a selected preview frame. The row remains the link; the filmstrip only
  changes which decorative preview is shown beside it.

  JavaScript adds memory and autoplay. Without it, CSS still lets row hover or
  focus choose an experiment and shows that item's first frame. The filmstrip
  stays hidden in that fallback so it never exposes controls that do nothing.
*/
type PlayItem = {
  id: string;
  data: {
    title: string;
    description: string;
    media: {
      thumbnail?: string;
      hero?: string;
      heroDark?: string;
    };
    previews: string[];
  };
};

interface Props {
  items: PlayItem[];
}

const { items } = Astro.props;

const VIDEO = /\.(mp4|webm|mov)$/i;
/* The component supports up to three frames, but missing sources disappear
   completely: no empty autoplay stop and no inert thumbnail button. */
const framesFor = (previews: string[]) => previews.slice(0, 3).filter(Boolean);
---

<div class="play-preview">
  <div class="play-preview__list">
    {items.map((item) => (
      <a class="play-item" href={`/play/${item.id}`} data-play-row>
        {item.data.media.thumbnail ? (
          <img
            class="play-item__thumb"
            src={item.data.media.thumbnail}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="play-item__thumb"></span>
        )}
        <span class="play-item__body">
          <span class="play-item__title">
            {item.data.title}<span class="card-title__arrow" aria-hidden="true">&rarr;</span>
          </span>
          <span class="play-item__subtitle">{item.data.description}</span>
        </span>
      </a>
    ))}
  </div>

  <div class="play-preview__pane">
    {items.map((item) => {
      const authoredFrames = framesFor(item.data.previews);
      const frames = authoredFrames.length > 0
        ? authoredFrames
        : item.data.media.thumbnail
          ? [item.data.media.thumbnail]
          : item.data.media.hero
            ? [item.data.media.hero]
          : [];
      const usesThemeFallback =
        authoredFrames.length === 0 &&
        !item.data.media.thumbnail &&
        Boolean(item.data.media.hero);
      return (
        <div class="play-preview__set" data-play-set>
          {/* The row already names and links the work; main media is visual. */}
          <div class="play-preview__main" aria-hidden="true">
            {frames.map((src, frameIndex) => (
              <div class="play-preview__frame" data-play-frame={frameIndex}>
                {usesThemeFallback ? (
                  <ThemeImage
                    lightSrc={src}
                    darkSrc={item.data.media.heroDark}
                    alt=""
                  />
                ) : VIDEO.test(src) ? (
                  <video src={src} muted loop playsinline preload="none" autoplay></video>
                ) : (
                  <img src={src} alt="" loading="lazy" decoding="async" />
                )}
              </div>
            ))}
          </div>

          {authoredFrames.length > 0 && (
            <div
              class="play-preview__filmstrip"
              role="group"
              data-preview-count={frames.length}
              aria-label={`${item.data.title} previews`}
            >
              {frames.map((src, frameIndex) => (
                <button
                  type="button"
                  class="play-preview__thumbnail"
                  data-play-thumbnail={frameIndex}
                  aria-label={`Show ${item.data.title} preview ${
                    frameIndex + 1
                  } of ${frames.length}`}
                  aria-pressed="false"
                >
                  {VIDEO.test(src) ? (
                    <video src={src} muted playsinline preload="metadata" aria-hidden="true"></video>
                  ) : (
                    <img src={src} alt="" loading="lazy" decoding="async" />
                  )}
                  <span class="play-preview__loader" aria-hidden="true">
                    <span class="play-preview__loader-fill"></span>
                  </span>
                </button>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".play-preview");

  if (root) {
    const CYCLE_DURATION = 4000;
    const rows = [...root.querySelectorAll<HTMLElement>("[data-play-row]")];
    const sets = [...root.querySelectorAll<HTMLElement>("[data-play-set]")];
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const desktop = window.matchMedia("(min-width: 56rem)");

    let activeSetIndex = 0;
    let activeFrameIndex = 0;
    let pinnedFrameIndex: number | null = null;
    let pointerInspecting = false;
    let focusInspecting = false;
    let sectionVisible = !("IntersectionObserver" in window);
    let progressAnimation: Animation | null = null;

    const activeSet = () => sets[activeSetIndex];
    const activeFrames = () => [
      ...(activeSet()?.querySelectorAll<HTMLElement>("[data-play-frame]") ?? []),
    ];
    const activeThumbnails = () => [
      ...(activeSet()?.querySelectorAll<HTMLButtonElement>("[data-play-thumbnail]") ?? []),
    ];

    const cancelProgress = () => {
      progressAnimation?.cancel();
      progressAnimation = null;
      for (const fill of root.querySelectorAll<HTMLElement>(".play-preview__loader-fill")) {
        fill.style.transform = "scaleX(0)";
      }
    };

    const autoplayAllowed = () =>
      desktop.matches &&
      !reduceMotion.matches &&
      !document.hidden &&
      sectionVisible &&
      !pointerInspecting &&
      !focusInspecting &&
      pinnedFrameIndex === null &&
      activeFrames().length > 1;

    const syncVideos = () => {
      const mayPlay =
        desktop.matches &&
        !reduceMotion.matches &&
        !document.hidden &&
        sectionVisible;
      for (const [setIndex, set] of sets.entries()) {
        const frames = [...set.querySelectorAll<HTMLElement>("[data-play-frame]")];
        for (const [frameIndex, frame] of frames.entries()) {
          const video = frame.querySelector("video");
          if (!video) continue;
          if (mayPlay && setIndex === activeSetIndex && frameIndex === activeFrameIndex) {
            video.autoplay = true;
            void video.play().catch(() => {});
          } else {
            video.autoplay = false;
            video.pause();
          }
        }
      }
    };

    const syncFrameState = () => {
      for (const [frameIndex, frame] of activeFrames().entries()) {
        frame.classList.toggle("play-preview__frame--active", frameIndex === activeFrameIndex);
      }
      for (const [frameIndex, thumbnail] of activeThumbnails().entries()) {
        const selected = frameIndex === activeFrameIndex;
        thumbnail.classList.toggle("play-preview__thumbnail--active", selected);
        thumbnail.setAttribute("aria-pressed", String(selected));
      }
      syncVideos();
    };

    const startProgress = () => {
      if (!autoplayAllowed()) return;
      const fill = activeThumbnails()[activeFrameIndex]
        ?.querySelector<HTMLElement>(".play-preview__loader-fill");
      if (!fill) return;

      progressAnimation = fill.animate(
        [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
        { duration: CYCLE_DURATION, easing: "linear", fill: "forwards" },
      );
      const animation = progressAnimation;
      void animation.finished
        .then(() => {
          if (progressAnimation !== animation || !autoplayAllowed()) return;
          progressAnimation = null;
          activeFrameIndex = (activeFrameIndex + 1) % activeFrames().length;
          cancelProgress();
          syncFrameState();
          startProgress();
        })
        .catch(() => {});
    };

    const syncProgress = () => {
      if (autoplayAllowed()) {
        if (progressAnimation?.playState === "paused") progressAnimation.play();
        else if (!progressAnimation) startProgress();
      } else if (progressAnimation?.playState === "running") {
        progressAnimation.pause();
      }
    };

    const showFrame = (frameIndex: number) => {
      if (frameIndex < 0 || frameIndex >= activeFrames().length) return;
      cancelProgress();
      activeFrameIndex = frameIndex;
      syncFrameState();
      syncProgress();
    };

    const selectExperiment = (setIndex: number) => {
      if (setIndex < 0 || setIndex >= sets.length) return;
      cancelProgress();
      activeSetIndex = setIndex;
      activeFrameIndex = 0;
      pinnedFrameIndex = null;
      pointerInspecting = false;
      focusInspecting = false;

      for (const [index, set] of sets.entries()) {
        set.classList.toggle("play-preview__set--active", index === setIndex);
      }
      for (const [index, row] of rows.entries()) {
        row.classList.toggle("play-item--active", index === setIndex);
      }
      syncFrameState();
      syncProgress();
    };

    const finishManualInspection = () => {
      if (pointerInspecting || focusInspecting) return;
      if (pinnedFrameIndex !== null) showFrame(pinnedFrameIndex);
      else {
        cancelProgress();
        syncProgress();
      }
    };

    root.dataset.enhanced = "";
    selectExperiment(0);

    rows.forEach((row, setIndex) => {
      row.addEventListener("pointerenter", () => selectExperiment(setIndex));
      row.addEventListener("focus", () => selectExperiment(setIndex));
    });

    sets.forEach((set, setIndex) => {
      const thumbnails = [
        ...set.querySelectorAll<HTMLButtonElement>("[data-play-thumbnail]"),
      ];
      thumbnails.forEach((thumbnail, frameIndex) => {
        const inspect = () => {
          if (setIndex !== activeSetIndex) return;
          showFrame(frameIndex);
        };
        thumbnail.addEventListener("pointerenter", () => {
          pointerInspecting = true;
          inspect();
        });
        thumbnail.addEventListener("pointerleave", () => {
          pointerInspecting = false;
          finishManualInspection();
        });
        thumbnail.addEventListener("focus", () => {
          focusInspecting = true;
          inspect();
        });
        thumbnail.addEventListener("blur", () => {
          focusInspecting = false;
          finishManualInspection();
        });
        thumbnail.addEventListener("click", () => {
          pinnedFrameIndex = frameIndex;
          showFrame(frameIndex);
        });
      });
    });

    let warmed = false;
    root.addEventListener("pointerenter", () => {
      if (warmed) return;
      warmed = true;
      const sources = [...root.querySelectorAll<HTMLImageElement>(".play-preview__frame img")]
        .map((img) => img.currentSrc || img.src)
        .filter(Boolean);
      const warm = () => sources.forEach((src) => { new Image().src = src; });
      "requestIdleCallback" in window
        ? requestIdleCallback(warm, { timeout: 2000 })
        : setTimeout(warm, 200);
    }, { once: true });

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(([entry]) => {
        sectionVisible = entry.isIntersecting;
        syncVideos();
        syncProgress();
      }, { threshold: 0.2 });
      observer.observe(root);
    }

    const syncEnvironment = () => {
      if (reduceMotion.matches || !desktop.matches) cancelProgress();
      syncVideos();
      syncProgress();
    };
    document.addEventListener("visibilitychange", syncEnvironment);
    reduceMotion.addEventListener("change", syncEnvironment);
    desktop.addEventListener("change", syncEnvironment);
  }
</script>
