---
/*
  The site's one table. Callers write the <thead>/<tbody> into the slot; this
  supplies the class and, more importantly, the scroll container — a table is
  the one element whose columns cannot be reflowed, so it has to be able to
  scroll inside its own box rather than push the page sideways.

  Markdown tables get the same treatment through `.prose table` in global.css
  and do not go through this component; they have no wrapper element, so they
  become their own scroll container. See the TABLES block there.
*/
interface Props {
  /* Announced to screen readers in place of a visible caption. Give it when
     the surrounding heading does not already name what the table holds. */
  label?: string;
  class?: string;
  /* Keeps an explicit row-header column visible whenever a wide table scrolls.
     Callers must use <th scope="row"> in that column. */
  pinFirstColumn?: boolean;
}

/*
  There used to be an `interactive` prop here, turning on a whole-row hover for
  tables whose rows are links. Only the homepage Play list ever set it, and
  that list is `.play-preview` now — a set of bordered rows with a preview
  pane, not a table. Every remaining table on the site presents data and does
  not react to the pointer, so the variant went with its one caller.
*/

const { label, class: className, pinFirstColumn = false } = Astro.props;
---

<div
  class:list={["table-scroll", className]}
  data-table-scroll
  data-pin-first-column={pinFirstColumn ? "" : undefined}
>
  <table
    class:list={["data-table"]}
    aria-label={label}
  >
    <slot />
  </table>
</div>

<script>
  const initializeTableScroll = (region: HTMLElement) => {
    if (region.dataset.tableScrollReady === "true") return;

    const table = region.querySelector("table");
    if (!table) return;

    region.dataset.tableScrollReady = "true";
    const label = table.getAttribute("aria-label") ?? "Table";

    const syncOverflowState = () => {
      const isScrollable = region.scrollWidth > region.clientWidth;

      region.toggleAttribute("data-overflowing", isScrollable);

      if (isScrollable) {
        region.tabIndex = 0;
        region.setAttribute("role", "region");
        region.setAttribute("aria-label", `${label}, scrollable`);
      } else {
        region.removeAttribute("tabindex");
        region.removeAttribute("role");
        region.removeAttribute("aria-label");
      }
    };

    region.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      region.scrollBy({ left: direction * region.clientWidth });
    });

    const observer = new ResizeObserver(syncOverflowState);
    observer.observe(region);
    observer.observe(table);
    syncOverflowState();
  };

  document
    .querySelectorAll<HTMLElement>("[data-table-scroll]")
    .forEach(initializeTableScroll);
</script>
