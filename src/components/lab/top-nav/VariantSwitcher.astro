---
const isDev = import.meta.env.DEV;
---

{
  isDev && (
    <aside
      class="nav-variant-switcher"
      data-nav-variant-switcher
      aria-label="Top navigation prototype variants"
    >
      <button
        type="button"
        class="nav-variant-switcher__button"
        data-nav-variant-previous
        aria-label="Previous navigation variant"
      >
        <span aria-hidden="true">&larr;</span>
        <span class="nav-variant-switcher__button-label">Previous</span>
      </button>

      <span
        class="nav-variant-switcher__status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        <span data-nav-variant-label>A · Editorial split</span>
      </span>

      <button
        type="button"
        class="nav-variant-switcher__button"
        data-nav-variant-next
        aria-label="Next navigation variant"
      >
        <span class="nav-variant-switcher__button-label">Next</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </aside>
  )
}

<script>
  const variants = [
    { id: "A", name: "Editorial split" },
    { id: "B", name: "Centered axis" },
    { id: "C", name: "Compact identity rail" },
    { id: "D", name: "Modular grid bar" },
    { id: "E", name: "Quiet floating dock" },
  ] as const;

  const switcher = document.querySelector<HTMLElement>("[data-nav-variant-switcher]");

  if (switcher) {
    const label = switcher.querySelector<HTMLElement>("[data-nav-variant-label]");
    const previous = switcher.querySelector<HTMLButtonElement>("[data-nav-variant-previous]");
    const next = switcher.querySelector<HTMLButtonElement>("[data-nav-variant-next]");

    function indexFromUrl() {
      const requested = new URL(window.location.href).searchParams
        .get("variant")
        ?.toUpperCase();
      const index = variants.findIndex((variant) => variant.id === requested);
      return index < 0 ? 0 : index;
    }

    let currentIndex = indexFromUrl();

    function setVariant(index: number) {
      currentIndex = (index + variants.length) % variants.length;
      const variant = variants[currentIndex];

      document.documentElement.dataset.navVariant = variant.id;
      if (label) label.textContent = `${variant.id} · ${variant.name}`;

      const url = new URL(window.location.href);
      url.searchParams.set("variant", variant.id);
      history.replaceState({}, "", url);

      document.dispatchEvent(
        new CustomEvent("nav-variant-change", {
          bubbles: true,
          detail: {
            variant: variant.id,
            name: variant.name,
            index: currentIndex,
          },
        }),
      );
    }

    function hasEditingOrInteractiveTarget(target: EventTarget | null) {
      return (
        target instanceof Element &&
        Boolean(target.closest("input, textarea, select, button, a, [contenteditable]"))
      );
    }

    previous?.addEventListener("click", () => setVariant(currentIndex - 1));
    next?.addEventListener("click", () => setVariant(currentIndex + 1));

    document.addEventListener("keydown", (event) => {
      if (
        event.defaultPrevented ||
        event.repeat ||
        event.altKey ||
        event.ctrlKey ||
        event.metaKey ||
        hasEditingOrInteractiveTarget(event.target)
      ) {
        return;
      }

      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setVariant(currentIndex - 1);
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        setVariant(currentIndex + 1);
      }
    });

    setVariant(currentIndex);
  }
</script>

<style>
  .nav-variant-switcher {
    position: fixed;
    inset-inline-start: 50%;
    inset-block-end: max(var(--spacing-sm), env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-2xs);
    inline-size: min(
      calc(100% - (var(--spacing-gutter) * 2)),
      var(--container-measure)
    );
    padding: var(--spacing-2xs);
    transform: translateX(-50%);
    border: 1px solid var(--border-primary-solid);
    background: var(--background-alternate);
    color: var(--text-alternate);
    box-shadow: var(--light-shade-raised);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .nav-variant-switcher__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2xs);
    min-inline-size: var(--control-height-touch);
    min-block-size: var(--control-height-touch);
    padding-inline: var(--spacing-xs);
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    cursor: pointer;
  }

  .nav-variant-switcher__status {
    min-inline-size: 0;
    text-align: center;
  }

  .nav-variant-switcher__button-label {
    display: none;
  }

  @media (hover: hover) {
    .nav-variant-switcher__button:hover {
      background: var(--background-alternate-hover);
    }
  }

  .nav-variant-switcher__button:active {
    background: var(--background-alternate-hover);
  }

  @media (min-width: 38rem) {
    .nav-variant-switcher__button-label {
      display: inline;
    }
  }
</style>
