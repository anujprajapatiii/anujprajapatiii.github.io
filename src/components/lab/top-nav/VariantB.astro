---
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import { siteConfig } from "@/data/site-config";

interface Props {
  activeHref?: string;
}

const { activeHref = "/work" } = Astro.props;
---

<header class="top-nav top-nav--b" data-nav-option="B">
  <div class="top-nav__inner top-nav__inner--centered">
    <a
      href="/"
      class="wordmark top-nav__wordmark site-hit-target"
      aria-current={activeHref === "/" ? "page" : undefined}
    >
      {siteConfig.name}
    </a>

    <nav class="top-nav__links top-nav__center" aria-label="Primary navigation">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class="top-nav__link site-hit-target"
          aria-current={item.href === activeHref ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="top-nav__theme">
      <ThemeToggle />
    </div>
  </div>
</header>
