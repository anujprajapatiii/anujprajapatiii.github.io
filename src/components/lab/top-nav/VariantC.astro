---
import { siteConfig } from "@/data/site-config";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";

interface Props {
  activeHref?: string;
}

const { activeHref = "/work" } = Astro.props;
const indexItems = [
  { label: "Home", href: "/" },
  ...siteConfig.nav,
];
const isActive = (href: string) => href === activeHref;
const currentLabel =
  indexItems.find((item) => isActive(item.href))?.label ?? "Portfolio";
---

<header class="top-nav top-nav--c" data-nav-option="C">
  <div class="top-nav__frame top-nav-c__rail">
    <a
      href="/"
      class="top-nav__identity top-nav-c__identity site-hit-target"
      aria-current={isActive("/") ? "page" : undefined}
    >
      {siteConfig.name}
    </a>

    <p class="top-nav-c__current">
      <span class="top-nav-c__current-label">Current</span>
      <span class="top-nav-c__current-value">{currentLabel}</span>
    </p>

    <div class="top-nav-c__actions">
      <ThemeToggle />
      <button
        type="button"
        class="top-nav-c__index-trigger site-hit-target"
        popovertarget="top-nav-c-index"
        aria-label="Open navigation index"
      >
        Index
      </button>
    </div>
  </div>

  <div id="top-nav-c-index" class="top-nav-c__sheet" popover="auto">
    <div class="top-nav__frame top-nav-c__sheet-frame">
      <div class="top-nav-c__sheet-header">
        <p class="top-nav-c__sheet-title">Index</p>
        <button
          type="button"
          class="top-nav-c__sheet-close site-hit-target"
          popovertarget="top-nav-c-index"
          popovertargetaction="hide"
          aria-label="Close navigation index"
        >
          Close
        </button>
      </div>

      <nav class="top-nav-c__routes" aria-label="Portfolio index">
        {indexItems.map((item, index) => (
          <a
            href={item.href}
            class="top-nav-c__route site-hit-target"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <span class="top-nav-c__route-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
