---
import type { CollectionEntry } from "astro:content";
import DataTable from "@/components/DataTable.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import Stack from "@/components/primitives/Stack.astro";
import { projectTypeLabels } from "@/lib/content/project-types";

interface Props {
  project?: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<article class="table-study facts-rail-study">
  <Grid as="header" class="table-study__header table-study__header--compact">
    <GridItem spanMd={8}>
      <h2 id="facts-rail" class="text-heading">Facts rail</h2>
    </GridItem>
    <GridItem spanMd={16} startMd={9}>
      <p class="max-w-measure text-body text-muted-foreground">
        A single project's metadata becomes a vertical sequence of row labels
        and values, giving long skills and roles room to wrap.
      </p>
    </GridItem>
  </Grid>

  {project ? (
    <Grid class="facts-rail__frame">
      <GridItem spanMd={8}>
        <Stack gap="2xs">
          <h3 id="facts-project-heading" class="text-heading">
            {project.data.title}
          </h3>
          <p class="text-body text-muted-foreground">
            {project.data.description}
          </p>
        </Stack>
      </GridItem>
      <GridItem spanMd={16} startMd={9}>
        <DataTable
          label={`Project facts for ${project.data.title}`}
          class="facts-rail__table-wrap"
        >
          <tbody>
            <tr>
              <th scope="row">Type</th>
              <td>{projectTypeLabels[project.data.type]}</td>
            </tr>
            <tr>
              <th scope="row">Role</th>
              <td>{project.data.role ?? "Not specified"}</td>
            </tr>
            <tr>
              <th scope="row">Year</th>
              <td>
                <time datetime={project.data.publishedAt.toISOString()}>
                  {project.data.publishedAt.getUTCFullYear()}
                </time>
              </td>
            </tr>
            <tr>
              <th scope="row">Skills</th>
              <td>
                {project.data.skills.length > 0
                  ? project.data.skills.join(", ")
                  : "Not specified"}
              </td>
            </tr>
          </tbody>
        </DataTable>
      </GridItem>
    </Grid>
  ) : (
    <p class="text-body text-muted-foreground" role="status">
      No published project is available for this specimen.
    </p>
  )}
</article>
