---
import type { CollectionEntry } from "astro:content";
import DataTable from "@/components/DataTable.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import { projectTypeLabels } from "@/lib/content/project-types";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<article class="table-study quiet-ledger-study">
  <Grid as="header" class="table-study__header table-study__header--compact">
    <GridItem spanMd={8}>
      <h2 id="quiet-ledger" class="text-heading">Quiet ledger</h2>
    </GridItem>
    <GridItem spanMd={16} startMd={9}>
      <p class="max-w-measure text-body text-muted-foreground">
        Familiar column comparison with the vertical cell walls removed. A
        stronger header rule and quieter row rules carry the structure.
      </p>
    </GridItem>
  </Grid>

  <p class="table-lab__overflow-note text-body text-muted-foreground">
    Scroll horizontally to compare every column.
  </p>
  <DataTable
    label="Comparison of published projects by type, role, and year"
    class="table-lab__scroll quiet-ledger__scroll"
  >
    <thead>
      <tr>
        <th scope="col">Project</th>
        <th scope="col">Type</th>
        <th scope="col">Role</th>
        <th scope="col" class="quiet-ledger__numeric">Year</th>
      </tr>
    </thead>
    <tbody>
      {projects.map((project) => (
        <tr>
          <th scope="row">{project.data.title}</th>
          <td>{projectTypeLabels[project.data.type]}</td>
          <td>{project.data.role ?? "Not specified"}</td>
          <td class="quiet-ledger__numeric">
            <time datetime={project.data.publishedAt.toISOString()}>
              {project.data.publishedAt.getUTCFullYear()}
            </time>
          </td>
        </tr>
      ))}
    </tbody>
  </DataTable>
</article>
