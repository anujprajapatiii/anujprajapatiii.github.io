---
import SliderLab from "@/components/lab/sliders/SliderLab";
import Container from "@/components/primitives/Container.astro";
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title="Slider Lab — Anuj Prajapati"
  description="Three experimental Slider directions for the portfolio design system."
  noindex
>
  <Section size="page">
    <Container>
      <Stack gap="xl">
        <header>
          <Stack gap="sm">
            <h1 class="text-title">Slider lab</h1>
            <p class="max-w-measure text-muted-foreground">
              Three compact, DialKit-inspired treatments for approximate
              continuous values. Each keeps its label and live percentage
              inside the control while using our square, neutral system.
            </p>
            <p class="max-w-measure text-muted-foreground">
              Drag a thumb or focus it and use the arrow keys. No direction is
              selected yet.
            </p>
          </Stack>
        </header>

        <SliderLab client:load />
      </Stack>
    </Container>
  </Section>
</PageLayout>
