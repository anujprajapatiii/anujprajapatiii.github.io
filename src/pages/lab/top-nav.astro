---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/layout/Footer.astro";
import ActionLink from "@/components/ActionLink.astro";
import PlayPreviewList from "@/components/PlayPreviewList.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Container from "@/components/primitives/Container.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import VariantA from "@/components/lab/top-nav/VariantA.astro";
import VariantB from "@/components/lab/top-nav/VariantB.astro";
import VariantC from "@/components/lab/top-nav/VariantC.astro";
import VariantD from "@/components/lab/top-nav/VariantD.astro";
import VariantE from "@/components/lab/top-nav/VariantE.astro";
import VariantSwitcher from "@/components/lab/top-nav/VariantSwitcher.astro";
import "@/components/lab/top-nav/top-nav-lab.css";
import { siteConfig } from "@/data/site-config";
import {
  getFeaturedExperiments,
  getFeaturedProjects,
} from "@/lib/content/queries";

const featured = await getFeaturedProjects(4);
const play = await getFeaturedExperiments(5);
---

<BaseLayout
  title="Top navigation exploration — Anuj Prajapati"
  description="A private comparison surface for five portfolio navigation directions."
  noindex
>
  <script is:inline>
    (function () {
      var variants = ["A", "B", "C", "D", "E"];
      var requested = new URLSearchParams(window.location.search)
        .get("variant")
        ?.toUpperCase();
      document.documentElement.dataset.navVariant = variants.includes(requested)
        ? requested
        : "A";

      function syncScrollState() {
        document.documentElement.toggleAttribute(
          "data-nav-scrolled",
          window.scrollY > 8,
        );
      }

      syncScrollState();
      window.addEventListener("scroll", syncScrollState, { passive: true });

      document.addEventListener("nav-variant-change", function () {
        document.querySelectorAll("[popover]").forEach(function (popover) {
          try {
            if (popover.matches(":popover-open")) popover.hidePopover();
          } catch (error) {}
        });
      });
    })();
  </script>

  <a class="top-nav-lab__skip" href="#main-content">Skip to main content</a>

  <VariantA activeHref="/work" />
  <VariantB activeHref="/work" />
  <VariantC activeHref="/work" />
  <VariantD activeHref="/work" />
  <VariantE activeHref="/work" />

  <main id="main-content">
    <Section size="page">
      <Container>
        <Grid class="hero-grid">
          <GridItem spanLg={8}>
            <h1 class="hero-display">Monsoon Projects 2026</h1>
          </GridItem>
          <GridItem spanLg={16}>
            <div class="media-placeholder"></div>
          </GridItem>
        </Grid>
      </Container>
    </Section>

    <Section size="large" class="home-featured">
      <Container>
        <Stack gap="lg">
          <SectionHeading>Featured Projects</SectionHeading>
          <Grid>
            {featured.map((project) => (
              <GridItem spanMd={12}>
                <ProjectCard
                  id={project.id}
                  title={project.data.title}
                  description={project.data.description}
                  thumbnail={project.data.media.thumbnail}
                />
              </GridItem>
            ))}
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section size="large">
      <Container>
        <Stack gap="lg">
          <SectionHeading>Experiments</SectionHeading>
          <PlayPreviewList items={play} />
        </Stack>
      </Container>
    </Section>

    <Section size="large" id="connect">
      <Container>
        <Stack gap="sm">
          <SectionHeading>Get in touch</SectionHeading>
          <Cluster gap="lg" class="text-body">
            <ActionLink href={`mailto:${siteConfig.social.email}`} variant="link">
              {siteConfig.social.email}
            </ActionLink>
            <ActionLink href={siteConfig.social.github} variant="link">
              GitHub
            </ActionLink>
          </Cluster>
        </Stack>
      </Container>
    </Section>
  </main>

  <Footer />
  <VariantSwitcher />
</BaseLayout>
