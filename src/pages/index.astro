---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Grid from "@/components/primitives/Grid.astro";
import { siteConfig } from "@/data/site-config";
import { getCollection } from "astro:content";

const featured = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);

const play = (await getCollection("play", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<PageLayout>
  {/* Hero */}
  <Section size="xl">
    <Container size="wide">
      <Grid min="360px" gap="lg">
        <Stack gap="lg">
          <h1 class="text-display">
            Monsoon Projects 2026
          </h1>
          <div class="info-box">
            <div class="info-box__row">Brand &amp; Growth Designer</div>
            <a
              class="info-box__row flex items-center justify-between text-muted-foreground transition-colors hover:text-accent"
              href="#connect"
            >
              <span>Connect</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </Stack>
        <div class="hero-media" role="img" aria-label="Hero image placeholder"></div>
      </Grid>
    </Container>
  </Section>

  {/* Selected work */}
  <Section size="lg">
    <Container size="wide">
      <Stack gap="lg">
        <Cluster justify="between" align="baseline">
          <h2 class="text-h3">Selected work</h2>
          <a
            href="/work"
            class="text-small text-muted-foreground underline underline-offset-4 transition-colors hover:text-accent"
          >All work</a>
        </Cluster>
        <Grid min="440px" gap="lg">
          {featured.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              description={project.data.description}
              role={project.data.role}
              year={project.data.year}
              thumbnail={project.data.thumbnail}
            />
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  {/* Play — tabular list */}
  <Section size="lg">
    <Container size="wide">
      <Stack gap="lg">
        <Cluster justify="between" align="baseline">
          <h2 class="text-h3">Play</h2>
          <a
            href="/play"
            class="text-small text-muted-foreground underline underline-offset-4 transition-colors hover:text-accent"
          >All play</a>
        </Cluster>
        <div class="play-list">
          {play.map((item) => (
            <a href={`/play/${item.id}`} class="play-row">
              <Cluster justify="between" align="baseline" gap="md">
                <span class="play-row__title">{item.data.title}</span>
                <span class="play-row__meta">
                  {[item.data.role, item.data.year].filter(Boolean).join(" · ")}
                </span>
              </Cluster>
            </a>
          ))}
        </div>
      </Stack>
    </Container>
  </Section>

  {/* Connect */}
  <Section size="lg" id="connect">
    <Container size="wide">
      <Stack gap="md">
        <h2 class="text-h2">Let’s make something grow.</h2>
        <Cluster gap="lg" class="text-small">
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="underline underline-offset-4 transition-colors hover:text-accent"
          >{siteConfig.social.email}</a>
          <a
            href={siteConfig.social.github}
            class="text-muted-foreground underline underline-offset-4 transition-colors hover:text-accent"
          >GitHub</a>
        </Cluster>
      </Stack>
    </Container>
  </Section>
</PageLayout>
