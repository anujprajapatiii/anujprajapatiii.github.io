---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PlayPreviewList from "@/components/PlayPreviewList.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import ThemeImage from "@/components/ThemeImage.astro";
import RainOverlay from "@/components/RainOverlay.astro";
import { siteConfig } from "@/data/site-config";
import {
  getFeaturedExperiments,
  getFeaturedProjects,
} from "@/lib/content/queries";

const featured = await getFeaturedProjects(4);

/* Five, to match the preview pane: the switch in global.css has one rule per
   row, so the cap and that block have to agree. */
const play = await getFeaturedExperiments(5);
---

<PageLayout>
  {/* Hero */}
  <Section size="hero">
    <Container>
      <Grid class="hero-grid">
        <GridItem spanLg={8}>
          <Stack gap="lg">
            <h1 class="hero-display">
              Monsoon Projects 2026
            </h1>
            <div class="info-box">
              <div class="info-box__row">Brand &amp; Growth Designer</div>
              <a
                class="info-box__row flex items-center justify-between"
                href="#connect"
              >
                <span>Connect</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </Stack>
        </GridItem>
        <GridItem spanLg={16}>
          <ThemeImage
            lightSrc="/images/hero-placeholder-day.webp"
            darkSrc="/images/hero-placeholder-night.webp"
            alt=""
            class="theme-image--cover"
          >
            <RainOverlay slot="effect" />
          </ThemeImage>
        </GridItem>
      </Grid>
    </Container>
  </Section>

  {/* Featured projects */}
  <Section size="large">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="start">
          <SectionHeading>Featured Projects</SectionHeading>
          <a href="/work" class="btn btn--secondary">
            View all
            <span aria-hidden="true">&rarr;</span>
          </a>
        </Cluster>
        <Grid>
          {featured.map((project) => (
            <GridItem spanMd={12}>
              <ProjectCard
                id={project.id}
                title={project.data.title}
                description={project.data.description}
                thumbnail={project.data.media.thumbnail}
              />
            </GridItem>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  {/* Experiments — preview list */}
  <Section size="large">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="start">
          <SectionHeading>Experiments</SectionHeading>
          <a href="/play" class="btn btn--secondary">
            View all
            <span aria-hidden="true">&rarr;</span>
          </a>
        </Cluster>
        <PlayPreviewList items={play} />
      </Stack>
    </Container>
  </Section>

  {/* Connect */}
  <Section size="large" id="connect">
    <Container>
      <Stack gap="sm">
        <SectionHeading>Get in touch</SectionHeading>
        <Cluster gap="lg" class="text-meta">
          <a href={`mailto:${siteConfig.social.email}`} class="btn btn--link"
            >{siteConfig.social.email}</a
          >
          <a href={siteConfig.social.github} class="btn btn--link">GitHub</a>
        </Cluster>
      </Stack>
    </Container>
  </Section>
</PageLayout>
