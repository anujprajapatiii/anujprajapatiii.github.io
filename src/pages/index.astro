---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import DataTable from "@/components/DataTable.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Grid from "@/components/primitives/Grid.astro";
import { siteConfig } from "@/data/site-config";
import { getCollection } from "astro:content";

const featured = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);

const play = (await getCollection("play", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<PageLayout>
  {/* Hero */}
  <Section size="xl">
    <Container>
      <Grid min="360px" gap="lg">
        <Stack gap="lg">
          <h1 class="text-display">
            Monsoon Projects 2026
          </h1>
          <div class="info-box">
            <div class="info-box__row">Brand &amp; Growth Designer</div>
            <a
              class="info-box__row flex items-center justify-between text-muted-foreground transition-colors hover:text-accent"
              href="#connect"
            >
              <span>Connect</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </Stack>
        <div class="media-placeholder"></div>
      </Grid>
    </Container>
  </Section>

  {/* Selected work */}
  <Section size="lg">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="baseline">
          <h2 class="text-h3">Selected work</h2>
          <a href="/work" class="btn btn--secondary">
            All work
            <span aria-hidden="true">&rarr;</span>
          </a>
        </Cluster>
        <Grid min="440px" gap="lg">
          {featured.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              description={project.data.description}
              year={project.data.year}
              thumbnail={project.data.thumbnail}
            />
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  {/* Play — tabular list */}
  <Section size="lg">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="baseline">
          <h2 class="text-h3">Play</h2>
          <a href="/play" class="btn btn--secondary">
            All play
            <span aria-hidden="true">&rarr;</span>
          </a>
        </Cluster>
        <DataTable label="Play experiments" interactive>
          <thead>
            <tr>
              <th scope="col">Title</th>
              <th scope="col">Role</th>
              <th scope="col">Year</th>
            </tr>
          </thead>
          <tbody>
            {play.map((item) => (
              <tr>
                <td><a href={`/play/${item.id}`}>{item.data.title}</a></td>
                <td>{item.data.role}</td>
                <td>{item.data.year}</td>
              </tr>
            ))}
          </tbody>
        </DataTable>
      </Stack>
    </Container>
  </Section>

  {/* Connect */}
  <Section size="lg" id="connect">
    <Container>
      <Stack gap="md">
        <h2 class="text-h2">Let’s make something grow.</h2>
        <Cluster gap="lg" class="text-small">
          <a href={`mailto:${siteConfig.social.email}`} class="btn btn--link"
            >{siteConfig.social.email}</a
          >
          <a href={siteConfig.social.github} class="btn btn--link">GitHub</a>
        </Cluster>
      </Stack>
    </Container>
  </Section>
</PageLayout>
