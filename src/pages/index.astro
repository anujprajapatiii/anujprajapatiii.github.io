---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import DataTable from "@/components/DataTable.astro";
import HalftoneBand from "@/components/HalftoneBand";
import HeroShader from "@/components/HeroShader";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Grid from "@/components/primitives/Grid.astro";
import { siteConfig } from "@/data/site-config";
import { getCollection } from "astro:content";

const featured = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);

const play = (await getCollection("play", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<PageLayout>
  {/* Hero */}
  <Section size="xl">
    <Container>
      <Grid min="360px" gap="lg">
        <Stack gap="lg">
          <h1 class="text-display">
            Monsoon Projects 2026
          </h1>
          <div class="info-box">
            <div class="info-box__row">Brand &amp; Growth Designer</div>
            <a
              class="info-box__row flex items-center justify-between"
              href="#connect"
            >
              <span>Connect</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </Stack>
        {/*
          client:load, not client:visible. This one is above the fold, so the
          observer would fire immediately anyway — but the directive is a
          promise about when the shape appears, and a hero that pops in a beat
          late reads as a page still loading. The band below stays lazy.
        */}
        <HeroShader client:load />
      </Grid>
    </Container>
  </Section>

  {/* Selected work */}
  <Section size="lg">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="baseline">
          <h2 class="text-h3">Selected work</h2>
          <a href="/work" class="btn btn--secondary">
            All work
            <span aria-hidden="true">&rarr;</span>
          </a>
        </Cluster>
        <Grid min="440px" gap="lg">
          {featured.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              description={project.data.description}
              year={project.data.year}
              thumbnail={project.data.thumbnail}
            />
          ))}
        </Grid>
        {/*
          Sibling of the Grid, not a child of it. In Paper it is the third item
          inside the card grid; as a real grid child it would drop into the
          next cell and take one column. Out here it spans the container, which
          is the full-width band the design shows.

          client:visible because it is below the fold and costs a WebGL
          context — nothing loads until it is scrolled to.
        */}
        <HalftoneBand client:visible />
      </Stack>
    </Container>
  </Section>

  {/* Play — tabular list */}
  <Section size="lg">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="baseline">
          <h2 class="text-h3">Play</h2>
          <a href="/play" class="btn btn--secondary">
            All play
            <span aria-hidden="true">&rarr;</span>
          </a>
        </Cluster>
        <DataTable label="Play experiments" interactive>
          <thead>
            <tr>
              <th scope="col">Title</th>
              <th scope="col">Role</th>
              <th scope="col">Year</th>
            </tr>
          </thead>
          <tbody>
            {play.map((item) => (
              <tr>
                <td>
                  {/*
                    One anchor per row, not three. It stretches over the whole
                    row from CSS (see .row-link), so the Role and Year cells are
                    clickable without existing as extra links — which would be
                    three tab stops and three announcements for one destination.
                  */}
                  <a class="row-link" href={`/play/${item.id}`}>
                    <span class="row-link__text">{item.data.title}</span>
                    <span class="row-link__arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </td>
                <td>{item.data.role}</td>
                <td>{item.data.year}</td>
              </tr>
            ))}
          </tbody>
        </DataTable>
      </Stack>
    </Container>
  </Section>

  {/* Connect */}
  <Section size="lg" id="connect">
    <Container>
      <Stack gap="md">
        <h2 class="text-h2">Let’s make something grow.</h2>
        <Cluster gap="lg" class="text-small">
          <a href={`mailto:${siteConfig.social.email}`} class="btn btn--link"
            >{siteConfig.social.email}</a
          >
          <a href={siteConfig.social.github} class="btn btn--link">GitHub</a>
        </Cluster>
      </Stack>
    </Container>
  </Section>
</PageLayout>
