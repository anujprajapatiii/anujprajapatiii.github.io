---
import PageLayout from "@/layouts/PageLayout.astro";
import ActionLink from "@/components/ActionLink.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PlayPreviewList from "@/components/PlayPreviewList.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import ThemeImage from "@/components/ThemeImage.astro";
import { siteConfig } from "@/data/site-config";
import {
  getFeaturedExperiments,
  getFeaturedProjects,
} from "@/lib/content/queries";

const featured = await getFeaturedProjects(4);

/* Five, to match the preview pane: the switch in global.css has one rule per
   row, so the cap and that block have to agree. */
const play = await getFeaturedExperiments(5);
---

<PageLayout>
  {/* Hero */}
  <Section size="hero">
    <Container>
      <Grid class="hero-grid">
        <GridItem spanLg={8}>
          <Stack gap="lg">
            <h1 class="hero-display">
              Monsoon Projects 2026
            </h1>
            <div class="info-box">
              <div class="info-box__row">Brand &amp; Growth Designer</div>
              <div class="info-box__row">Brand systems</div>
              <div class="info-box__row">Campaigns &amp; activations</div>
              <div class="info-box__row">Digital products</div>
            </div>
          </Stack>
        </GridItem>
        <GridItem spanLg={16}>
          <ThemeImage
            lightSrc="/images/hero-neutral-light.jpg"
            darkSrc="/images/hero-neutral-dark.jpg"
            alt=""
            class="theme-image--cover"
          />
        </GridItem>
      </Grid>
    </Container>
  </Section>

  {/* Featured projects */}
  <Section size="large" class="home-featured">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="start">
          <SectionHeading>Featured Projects</SectionHeading>
          <ActionLink href="/work">
            View all
            <span aria-hidden="true">&rarr;</span>
          </ActionLink>
        </Cluster>
        <Grid>
          {featured.map((project) => (
            <GridItem spanMd={12}>
              <ProjectCard
                id={project.id}
                title={project.data.title}
                description={project.data.description}
                thumbnail={project.data.media.thumbnail}
              />
            </GridItem>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  {/* Experiments — preview list */}
  <Section size="large">
    <Container>
      <Stack gap="lg">
        <Cluster justify="between" align="start">
          <SectionHeading>Experiments</SectionHeading>
          <ActionLink href="/play">
            View all
            <span aria-hidden="true">&rarr;</span>
          </ActionLink>
        </Cluster>
        <PlayPreviewList items={play} />
      </Stack>
    </Container>
  </Section>

  {/* Connect */}
  <Section size="large" id="connect">
    <Container>
      <Stack gap="sm">
        <SectionHeading>Get in touch</SectionHeading>
        <Cluster gap="lg" class="text-body">
          <ActionLink href={`mailto:${siteConfig.social.email}`} variant="link">
            {siteConfig.social.email}
          </ActionLink>
          <ActionLink href={siteConfig.social.github} variant="link">GitHub</ActionLink>
        </Cluster>
      </Stack>
    </Container>
  </Section>
</PageLayout>
