---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import { getCollection } from "astro:content";

const play = (await getCollection("play", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<PageLayout title="Experiments — Anuj Prajapati" description="Self-initiated experiments and side explorations.">
  <Section size="page">
    <Container>
      <Stack gap="lg">
        <Stack gap="sm">
          <h1 class="text-title">Experiments</h1>
          <p class="max-w-measure text-body text-muted-foreground">
            Self-initiated experiments and side explorations.
          </p>
        </Stack>
        <Grid>
          {play.map((item) => (
            <GridItem spanMd={12} spanLg={8}>
              <ProjectCard
                id={item.id}
                title={item.data.title}
                description={item.data.description}
                thumbnail={item.data.thumbnail}
                base="/play"
              />
            </GridItem>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>
</PageLayout>
