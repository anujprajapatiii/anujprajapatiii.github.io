---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Grid from "@/components/primitives/Grid.astro";
import { getCollection } from "astro:content";

const play = (await getCollection("play", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<PageLayout title="Play — Anuj Prajapati" description="Self-initiated experiments and side explorations.">
  <Section size="page">
    <Container>
      <Stack gap="lg">
        <Stack gap="md">
          <h1 class="text-h1">Play</h1>
          <p class="max-w-measure text-body text-muted-foreground">
            Self-initiated experiments and side explorations.
          </p>
        </Stack>
        <Grid min="280px" gap="md">
          {play.map((item) => (
            <ProjectCard
              id={item.id}
              title={item.data.title}
              description={item.data.description}
              thumbnail={item.data.thumbnail}
              base="/play"
            />
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>
</PageLayout>
