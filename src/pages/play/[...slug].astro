---
import PageLayout from "@/layouts/PageLayout.astro";
import EmbedFrame from "@/components/EmbedFrame.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Sidebar from "@/components/primitives/Sidebar.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import OnThisPage from "@/components/OnThisPage.astro";
import DataTable from "@/components/DataTable.astro";
import { getPublishedExperiments } from "@/lib/content/queries";
import { render } from "astro:content";

export async function getStaticPaths() {
  const play = await getPublishedExperiments();
  return play.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
const publishedYear = item.data.publishedAt.getUTCFullYear();
---

<PageLayout
  title={`${item.data.title} — Anuj Prajapati`}
  description={item.data.description}
  image={item.data.media.hero ?? item.data.media.thumbnail}
  palette={item.data.palette}
>
  <Section as="article" size="page" class="case-study">
    <Stack gap="xl">
    <Container as="header">
      <Grid class="case-study-header-grid">
        <GridItem spanLg={12}>
          <Stack gap="sm">
            {/* Cluster so the button shrink-wraps its label — a bare <a> in a
                Stack is a flex item and would stretch to the full column. */}
            <Cluster>
              <a href="/play" class="btn btn--secondary">
                <span aria-hidden="true">&larr;</span>
                Experiments
              </a>
            </Cluster>
            <h1 class="text-title">{item.data.title}</h1>
            <p class="type-reading max-w-measure">
              {item.data.description}
            </p>
          </Stack>
        </GridItem>

        <GridItem spanLg={12}>
          <Stack gap="sm">
            <DataTable label="Experiment details">
              <thead>
                <tr>
                  {item.data.role && <th scope="col">Role</th>}
                  <th scope="col">Year</th>
                  {item.data.skills.length > 0 && <th scope="col">Skills</th>}
                </tr>
              </thead>
              <tbody>
                <tr>
                  {item.data.role && <td>{item.data.role}</td>}
                  <td>{publishedYear}</td>
                  {item.data.skills.length > 0 && <td>{item.data.skills.join(", ")}</td>}
                </tr>
              </tbody>
            </DataTable>

            {item.data.liveUrl && (
              <Cluster>
                <a
                  href={item.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn--primary"
                >
                  Try it live
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </Cluster>
            )}
          </Stack>
        </GridItem>
      </Grid>
    </Container>

    {/* Breaks out of the reading column to full width — see EmbedFrame. */}
    {item.data.embedUrl && (
      <EmbedFrame
        url={item.data.embedUrl}
        title={item.data.title}
        onPhone={item.data.embedOnPhone}
      />
    )}

    <Container>
      <Stack gap="lg">
        {/*
          An embed is its own hero. An item that opens with a live tool
          (voxel) keeps its real imagery in the body and deliberately has no
          hero image — a grey placeholder above a working embed would add a
          picture of nothing to a page that already leads with something.
          Everything else shows the placeholder until a real image lands.
        */}
        {item.data.media.hero ? (
          <img
            src={item.data.media.hero}
            alt=""
            class="w-full"
          />
        ) : (
          !item.data.embedUrl && <div class="media-placeholder"></div>
        )}
        {/* Rail beside the body only: the table of contents belongs to the
            prose it describes, and the header above wants its full width. */}
        <Sidebar>
          <OnThisPage headings={headings} />
          <div class="prose">
            <Content />
          </div>
        </Sidebar>
      </Stack>
    </Container>
    </Stack>
  </Section>
</PageLayout>
