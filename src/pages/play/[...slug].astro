---
import PageLayout from "@/layouts/PageLayout.astro";
import EmbedFrame from "@/components/EmbedFrame.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Sidebar from "@/components/primitives/Sidebar.astro";
import OnThisPage from "@/components/OnThisPage.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const play = await getCollection("play", ({ data }) => !data.draft);
  return play.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
---

<PageLayout
  title={`${item.data.title} — Anuj Prajapati`}
  description={item.data.description}
  image={item.data.heroImage ?? item.data.thumbnail}
>
  <Section as="article" size="page">
    <Stack gap="xl">
    <Container as="header">
      <Stack gap="lg">
        <Stack gap="md">
          <a
            href="/play"
            class="text-small text-muted-foreground transition-colors hover:text-accent"
          >&larr; Play</a>
          <h1 class="text-h1">{item.data.title}</h1>
          <p class="max-w-measure text-lead text-muted-foreground">
            {item.data.description}
          </p>
        </Stack>

        <Cluster as="dl" gap="lg" align="start" class="border-t border-border pt-md">
          {item.data.role && (
            <div>
              <dt class="label">Role</dt>
              <dd class="mt-3xs text-small">{item.data.role}</dd>
            </div>
          )}
          {item.data.year && (
            <div>
              <dt class="label">Year</dt>
              <dd class="mt-3xs text-small">{item.data.year}</dd>
            </div>
          )}
          {item.data.skills.length > 0 && (
            <div>
              <dt class="label">Skills</dt>
              <dd class="mt-3xs text-small">{item.data.skills.join(", ")}</dd>
            </div>
          )}
        </Cluster>

        {item.data.liveUrl && (
          <Cluster>
            <a
              href={item.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2xs border border-border px-sm py-2xs text-small transition-colors hover:border-border-hover hover:text-accent"
            >
              Try it live
              <span aria-hidden="true">&rarr;</span>
            </a>
          </Cluster>
        )}
      </Stack>
    </Container>

    {/* Breaks out of the reading column to full width — see EmbedFrame. */}
    {item.data.embedUrl && (
      <EmbedFrame url={item.data.embedUrl} title={item.data.title} />
    )}

    <Container>
      <Stack gap="lg">
        {item.data.heroImage && (
          <img
            src={item.data.heroImage}
            alt=""
            class="w-full border border-border"
          />
        )}
        {/* Rail beside the body only: the table of contents belongs to the
            prose it describes, and the header above wants its full width. */}
        <Sidebar>
          <OnThisPage headings={headings} />
          <div class="prose">
            <Content />
          </div>
        </Sidebar>
      </Stack>
    </Container>
    </Stack>
  </Section>
</PageLayout>
