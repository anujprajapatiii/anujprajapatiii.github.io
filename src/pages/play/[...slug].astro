---
import PageLayout from "@/layouts/PageLayout.astro";
import EmbedFrame from "@/components/EmbedFrame.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Sidebar from "@/components/primitives/Sidebar.astro";
import OnThisPage from "@/components/OnThisPage.astro";
import DataTable from "@/components/DataTable.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const play = await getCollection("play", ({ data }) => !data.draft);
  return play.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
---

<PageLayout
  title={`${item.data.title} — Anuj Prajapati`}
  description={item.data.description}
  image={item.data.heroImage ?? item.data.thumbnail}
>
  <Section as="article" size="page">
    <Stack gap="xl">
    <Container as="header">
      <Stack gap="lg">
        <Stack gap="md">
          <a
            href="/play"
            class="text-small text-muted-foreground transition-colors hover:text-accent"
          >&larr; Play</a>
          <h1 class="text-h1">{item.data.title}</h1>
          <p class="max-w-measure text-lead text-muted-foreground">
            {item.data.description}
          </p>
        </Stack>

        <DataTable label="Experiment details">
          <thead>
            <tr>
              {item.data.role && <th scope="col">Role</th>}
              {item.data.year && <th scope="col">Year</th>}
              {item.data.skills.length > 0 && <th scope="col">Skills</th>}
            </tr>
          </thead>
          <tbody>
            <tr>
              {item.data.role && <td>{item.data.role}</td>}
              {item.data.year && <td>{item.data.year}</td>}
              {item.data.skills.length > 0 && <td>{item.data.skills.join(", ")}</td>}
            </tr>
          </tbody>
        </DataTable>

        {item.data.liveUrl && (
          <Cluster>
            <a
              href={item.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2xs border border-border px-sm py-2xs text-small transition-colors hover:border-border-hover hover:text-accent"
            >
              Try it live
              <span aria-hidden="true">&rarr;</span>
            </a>
          </Cluster>
        )}
      </Stack>
    </Container>

    {/* Breaks out of the reading column to full width — see EmbedFrame. */}
    {item.data.embedUrl && (
      <EmbedFrame url={item.data.embedUrl} title={item.data.title} />
    )}

    <Container>
      <Stack gap="lg">
        {/*
          An embed is its own hero. An item that opens with a live tool
          (voxel) keeps its real imagery in the body and deliberately has no
          hero image — a grey placeholder above a working embed would add a
          picture of nothing to a page that already leads with something.
          Everything else shows the placeholder until a real image lands.
        */}
        {item.data.heroImage ? (
          <img
            src={item.data.heroImage}
            alt=""
            class="w-full border border-border"
          />
        ) : (
          !item.data.embedUrl && <div class="media-placeholder"></div>
        )}
        {/* Rail beside the body only: the table of contents belongs to the
            prose it describes, and the header above wants its full width. */}
        <Sidebar>
          <OnThisPage headings={headings} />
          <div class="prose">
            <Content />
          </div>
        </Sidebar>
      </Stack>
    </Container>
    </Stack>
  </Section>
</PageLayout>
