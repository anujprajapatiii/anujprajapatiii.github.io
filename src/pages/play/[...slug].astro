---
import PageLayout from "@/layouts/PageLayout.astro";
import EmbedFrame from "@/components/EmbedFrame.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const play = await getCollection("play", ({ data }) => !data.draft);
  return play.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<PageLayout
  title={`${item.data.title} — Anuj Prajapati`}
  description={item.data.description}
  image={item.data.heroImage ?? item.data.thumbnail}
>
  <article class="pt-12 pb-24 sm:pt-20">
    <header class="mx-auto mb-12 max-w-content px-6">
      <a
        href="/play"
        class="label"
      >&larr; Play</a>
      <h1 class="mt-6 text-h1 font-medium">
        {item.data.title}
      </h1>
      <p class="mt-4 max-w-narrow text-lead text-muted-foreground">
        {item.data.description}
      </p>
      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-border pt-6">
        {item.data.role && (
          <div>
            <dt class="label">Role</dt>
            <dd class="mt-1 text-small">{item.data.role}</dd>
          </div>
        )}
        {item.data.year && (
          <div>
            <dt class="label">Year</dt>
            <dd class="mt-1 text-small">{item.data.year}</dd>
          </div>
        )}
        {item.data.skills.length > 0 && (
          <div>
            <dt class="label">Skills</dt>
            <dd class="mt-1 text-small">{item.data.skills.join(", ")}</dd>
          </div>
        )}
      </dl>
      {item.data.liveUrl && (
        <a
          href={item.data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-small transition-colors hover:border-foreground/40 hover:text-accent"
        >
          Try it live
          <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </header>

    {item.data.embedUrl && (
      <EmbedFrame url={item.data.embedUrl} title={item.data.title} />
    )}

    <div class="mx-auto max-w-content px-6">
      {item.data.heroImage && (
        <img
          src={item.data.heroImage}
          alt=""
          class="mb-12 w-full rounded-xl border border-border"
        />
      )}

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</PageLayout>
