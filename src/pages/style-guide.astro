<script>
  /*
    Fills each primitive swatch's caption with the colour the stylesheet
    actually resolved, rather than a hex literal copied into this file.

    The copies were the problem: 39 of them, hand-maintained, in the page whose
    job is to document the source of truth. Nothing checked them, so this page
    could show one colour while the site rendered another and look correct
    doing it. Reading the computed value means the caption is wrong only if the
    swatch beside it is wrong too.
  */
  const root = getComputedStyle(document.documentElement);
  for (const el of document.querySelectorAll<HTMLElement>("[data-swatch-value]")) {
    const raw = root.getPropertyValue(el.dataset.swatchValue!).trim();
    /* The build minifies #000000 to #000, so some values can arrive
       three digits wide and the caption column would carry two formats. */
    el.textContent = raw.replace(/^#([\da-f])([\da-f])([\da-f])$/i, "#$1$1$2$2$3$3") || "—";
  }
</script>
