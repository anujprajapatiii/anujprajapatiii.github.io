---
import PageLayout from "@/layouts/PageLayout.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import DataTable from "@/components/DataTable.astro";

/* Keep these arrays in sync with the token block in src/styles/global.css
   (see agent-os/plans/design-token-session.md). */

/* Only names and mappings live here. Swatches read computed CSS variables, so
   global.css remains the implementation source of truth for actual values. */
const primitiveFamilies = [
  {
    name: "Neutral",
    prefix: "neutral",
    swatches: ["black", "900", "800", "700", "600", "500", "400", "350", "300", "200", "100", "white"],
  },
  {
    name: "Brown",
    prefix: "brown",
    swatches: ["600", "500", "400", "300", "200", "100", "50"],
  },
  {
    name: "Amber",
    prefix: "amber",
    swatches: ["400", "300", "200", "100"],
  },
  {
    name: "Blue",
    prefix: "blue",
    swatches: ["900", "800", "700", "600", "500", "400", "300", "200", "100"],
  },
  {
    name: "Green",
    prefix: "green",
    swatches: ["400", "300", "200", "100"],
  },
  {
    name: "Red",
    prefix: "red",
    swatches: ["400", "300", "200", "100"],
  },
  {
    name: "Yellow",
    prefix: "yellow",
    swatches: ["600", "500", "400", "300", "200", "100"],
  },
];

const backgroundTokens = [
  { name: "primary", light: "neutral-100", dark: "neutral-800" },
  { name: "secondary", light: "neutral-200", dark: "neutral-600" },
  { name: "tertiary", light: "yellow-500", dark: "yellow-500" },
  { name: "quaternary", light: "white", dark: "neutral-700" },
  { name: "primary-hover", light: "white", dark: "neutral-700" },
  { name: "secondary-hover", light: "neutral-100", dark: "neutral-500" },
  { name: "tertiary-hover", light: "yellow-600", dark: "yellow-400" },
  { name: "quaternary-hover", light: "white", dark: "neutral-600" },
  { name: "black-solid", light: "neutral-800", dark: "neutral-100" },
  { name: "black-solid-hover", light: "black", dark: "white" },
  { name: "disabled", light: "neutral-200", dark: "neutral-600" },
  { name: "disabled-alt", light: "neutral-100", dark: "neutral-700" },
  { name: "accent-primary", light: "brown-50", dark: "brown-600" },
  { name: "accent-primary-hover", light: "brown-100", dark: "brown-500" },
  { name: "accent-solid", light: "brown-400", dark: "brown-200" },
  { name: "accent-solid-hover", light: "brown-500", dark: "brown-100" },
  { name: "error-primary", light: "red-100", dark: "red-100" },
  { name: "error-primary-hover", light: "red-200", dark: "red-200" },
  { name: "error-secondary", light: "red-300", dark: "red-300" },
  { name: "error-secondary-hover", light: "red-400", dark: "red-400" },
  { name: "success-primary", light: "green-100", dark: "green-100" },
  { name: "success-primary-hover", light: "green-200", dark: "green-200" },
  { name: "success-secondary", light: "green-300", dark: "green-300" },
  { name: "success-secondary-hover", light: "green-400", dark: "green-400" },
  { name: "warning-primary", light: "yellow-200", dark: "yellow-200" },
  { name: "warning-primary-hover", light: "yellow-300", dark: "yellow-300" },
  { name: "warning-secondary", light: "yellow-400", dark: "yellow-400" },
  { name: "warning-secondary-hover", light: "yellow-500", dark: "yellow-500" },
  { name: "info-primary", light: "blue-100", dark: "blue-100" },
  { name: "info-primary-hover", light: "blue-200", dark: "blue-200" },
  { name: "info-secondary", light: "blue-400", dark: "blue-400" },
  { name: "info-secondary-hover", light: "blue-500", dark: "blue-500" },
];

const textTokens = [
  { name: "primary", light: "neutral-600", dark: "neutral-200" },
  { name: "secondary", light: "neutral-400", dark: "neutral-300" },
  { name: "tertiary", light: "neutral-350", dark: "neutral-350" },
  { name: "primary-hover", light: "neutral-900", dark: "neutral-100" },
  { name: "secondary-hover", light: "neutral-600", dark: "neutral-200" },
  { name: "tertiary-hover", light: "neutral-400", dark: "neutral-300" },
  { name: "disabled", light: "neutral-300", dark: "neutral-500" },
  { name: "disabled-alt", light: "neutral-200", dark: "neutral-400" },
  { name: "placeholder", light: "neutral-350", dark: "neutral-350" },
  { name: "accent-primary", light: "brown-400", dark: "brown-100" },
  { name: "accent-secondary", light: "brown-300", dark: "brown-200" },
  { name: "accent-primary-hover", light: "brown-500", dark: "brown-50" },
  { name: "accent-secondary-hover", light: "brown-400", dark: "brown-100" },
  { name: "error-primary", light: "red-400", dark: "red-100" },
  { name: "error-secondary", light: "red-300", dark: "red-200" },
  { name: "error-primary-hover", light: "red-400", dark: "red-100" },
  { name: "error-secondary-hover", light: "red-400", dark: "red-100" },
  { name: "success-primary", light: "green-400", dark: "green-100" },
  { name: "success-secondary", light: "green-300", dark: "green-200" },
  { name: "success-primary-hover", light: "green-400", dark: "green-100" },
  { name: "success-secondary-hover", light: "green-400", dark: "green-100" },
  { name: "warning-primary", light: "yellow-600", dark: "yellow-200" },
  { name: "warning-secondary", light: "yellow-500", dark: "yellow-300" },
  { name: "warning-primary-hover", light: "yellow-600", dark: "yellow-100" },
  { name: "warning-secondary-hover", light: "yellow-600", dark: "yellow-200" },
  { name: "info-primary", light: "blue-600", dark: "blue-200" },
  { name: "info-secondary", light: "blue-500", dark: "blue-300" },
  { name: "info-primary-hover", light: "blue-600", dark: "blue-100" },
  { name: "info-secondary-hover", light: "blue-600", dark: "blue-200" },
];

const borderTokens = [
  { name: "primary", light: "neutral-300", dark: "neutral-500" },
  { name: "secondary", light: "brown-200", dark: "brown-400" },
  { name: "tertiary", light: "neutral-200", dark: "neutral-600" },
  { name: "primary-solid", light: "neutral-800", dark: "neutral-100" },
  { name: "disabled", light: "neutral-200", dark: "neutral-600" },
  { name: "disabled-alt", light: "neutral-100", dark: "neutral-700" },
  { name: "accent-primary", light: "brown-300", dark: "brown-200" },
  { name: "accent-secondary", light: "brown-100", dark: "brown-400" },
  { name: "error-primary", light: "red-300", dark: "red-200" },
  { name: "error-secondary", light: "red-100", dark: "red-400" },
  { name: "success-primary", light: "green-300", dark: "green-200" },
  { name: "success-secondary", light: "green-100", dark: "green-400" },
  { name: "warning-primary", light: "yellow-500", dark: "yellow-300" },
  { name: "warning-secondary", light: "yellow-300", dark: "yellow-600" },
  { name: "info-primary", light: "blue-400", dark: "blue-300" },
  { name: "info-secondary", light: "blue-200", dark: "blue-600" },
];

const semanticGroups = [
  {
    name: "Background",
    tokens: backgroundTokens.map((token) => ({ ...token, name: `bg-${token.name}` })),
  },
  {
    name: "Text",
    tokens: textTokens.map((token) => ({ ...token, name: `text-${token.name}` })),
  },
  {
    name: "Icon",
    tokens: textTokens.map((token) => ({ ...token, name: `icon-${token.name}` })),
  },
  {
    name: "Border",
    tokens: borderTokens.map((token) => ({ ...token, name: `border-${token.name}` })),
  },
  {
    name: "Portfolio-specific",
    tokens: [
      { name: "background-primary", light: "bg-primary", dark: "bg-primary" },
      { name: "background-secondary", light: "bg-secondary", dark: "bg-secondary" },
      { name: "background-alternate", light: "bg-black-solid", dark: "bg-black-solid" },
      { name: "background-alternate-hover", light: "bg-black-solid-hover", dark: "bg-black-solid-hover" },
      { name: "background-hover", light: "bg-primary-hover", dark: "bg-primary-hover" },
      { name: "background-elevated", light: "bg-quaternary", dark: "bg-quaternary" },
      { name: "background-elevated-hover", light: "bg-quaternary-hover", dark: "bg-quaternary-hover" },
      { name: "text-interactive", light: "text-primary-hover", dark: "text-primary-hover" },
      { name: "text-reading", light: "text-secondary", dark: "text-secondary" },
      { name: "text-alternate", light: "neutral-100", dark: "neutral-800" },
      { name: "border-hover", light: "neutral-350", dark: "neutral-400" },
      { name: "shader-tint", light: "neutral-500", dark: "neutral-300" },
      { name: "decorative-accent", light: "brown-300", dark: "brown-300" },
    ],
  },
];

/* `face` names the typeface as well as the weight, because the display step is
   no longer in the same family as the rest of the scale. */
const typeScale = [
  { name: "display", class: "text-display", size: "clamp(40px → 64px) / 1.02", weight: "Violet Sans 400", sample: "Display" },
  { name: "title", class: "text-title", size: "clamp(32px → 44px) / 1.08", weight: "TASA Orbiter Regular 400", sample: "Page title" },
  { name: "heading", class: "text-heading", size: "20px / 1.3", weight: "TASA Orbiter Medium 500", sample: "Shared heading" },
  { name: "body", class: "text-body", size: "16px / 1.5", weight: "TASA Orbiter Regular 400", sample: "Body text. The quick brown fox jumps over the lazy dog." },
  { name: "meta", class: "text-meta", size: "14px / 1.5", weight: "TASA Orbiter Regular 400", sample: "Metadata, captions, and compact interface text" },
];

const spacingScale = [
  { name: "3xs", value: "0.25rem", px: "4px" },
  { name: "2xs", value: "0.5rem", px: "8px" },
  { name: "xs", value: "0.75rem", px: "12px" },
  { name: "sm", value: "1rem", px: "16px" },
  { name: "md", value: "1.5rem", px: "24px" },
  { name: "lg", value: "2rem", px: "32px" },
  { name: "xl", value: "3rem", px: "48px" },
  { name: "2xl", value: "4rem", px: "64px" },
  { name: "3xl", value: "6rem", px: "96px" },
  { name: "4xl", value: "8rem", px: "128px" },
];

const semanticSpacing = [
  { name: "gutter", value: "20px — page inset and safe-area floor" },
  { name: "section", value: "clamp(48px → 96px) — section rhythm" },
  { name: "stack", value: "16px — gap between stacked elements" },
  { name: "card", value: "16px — card interior padding" },
  { name: "grid", value: "10px — structural grid gutter" },
];

const containers = [
  { name: "page", value: "81.25rem", px: "1300px content + 20px insets" },
  { name: "measure", value: "36rem", px: "576px" },
];

const aliases = [
  { name: "background", to: "background-primary" },
  { name: "foreground", to: "text-primary" },
  { name: "card", to: "background-elevated" },
  { name: "muted", to: "background-secondary" },
  { name: "muted-foreground", to: "text-secondary" },
  { name: "accent", to: "text-interactive" },
  { name: "accent-foreground", to: "text-alternate" },
  { name: "border", to: "border-primary" },
  { name: "ring", to: "border-hover" },
];

const pagePaletteRows = [
  {
    name: "Default",
    id: "default",
    light: "neutral-100 / neutral-600 / neutral-600",
    dark: "neutral-800 / neutral-200 / neutral-200",
    use: "Site default",
  },
  {
    name: "Blue",
    id: "blue",
    light: "blue-100 / blue-600 / blue-600",
    dark: "blue-900 / blue-200 / blue-300",
    use: "Sample Case Study",
  },
];
---

<PageLayout title="Style Guide — Anuj Prajapati" description="Internal design-system reference." noindex preloadDisplayFont>
  <Section size="page">
    <Container>
    <h1 class="mb-2xs text-title">Style guide</h1>
    <p class="mb-xl text-muted-foreground">
      Internal reference for the token system — base tokens live in
      <code>src/styles/global.css</code> and authored page palettes live in
      <code>src/styles/themes/</code>. Toggle dark mode in the header to check
      both appearance modes. Update this page whenever tokens change.
    </p>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Primitives
      </h2>
      <p class="mb-md text-meta text-muted-foreground">
        Raw palette. Same values in both themes; components never use these directly.
      </p>
      <Stack gap="md">
        {primitiveFamilies.map((family) => (
          <div>
            <p class="label mb-2xs">{family.name}</p>
            <Cluster gap="2xs" align="start">
              {family.swatches.map((swatch) => (
                <div class="w-16">
                  <div
                    class="h-10 border border-border"
                    style={`background: var(--${family.prefix}-${swatch})`}
                  ></div>
                  <p class="mt-3xs text-meta tabular-nums text-muted-foreground">
                    {swatch}<br /><span data-swatch-value={`--${family.prefix}-${swatch}`}>…</span>
                  </p>
                </div>
              ))}
            </Cluster>
          </div>
        ))}
      </Stack>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Semantic tokens
      </h2>
      <p class="mb-md text-meta text-muted-foreground">
        Semantic role names. The swatch shows the token in the theme you're
        viewing; the caption lists its light → dark primitive mapping.
      </p>
      <Stack gap="lg">
        {semanticGroups.map((group) => (
          <div>
            <p class="label mb-2xs">{group.name}</p>
            <Grid>
              {group.tokens.map((token) => (
                <GridItem span={12} spanMd={8}>
                  <div class="border border-border p-xs">
                    <div
                      class="h-12 border border-border"
                      style={`background: var(--${token.name})`}
                    ></div>
                    <p class="mt-2xs text-meta">--{token.name}</p>
                    <p class="text-meta tabular-nums text-muted-foreground">
                      {token.light} → {token.dark}
                    </p>
                  </div>
                </GridItem>
              ))}
            </Grid>
          </div>
        ))}
      </Stack>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Aliases
      </h2>
      <p class="mb-md text-meta text-muted-foreground">
        Internal names the components use, pointed at the semantic tokens above.
      </p>
      <Grid>
        {aliases.map((alias) => (
          <GridItem spanMd={12}>
            <p class="text-meta text-muted-foreground">
              --{alias.name} → {alias.to}
            </p>
          </GridItem>
        ))}
      </Grid>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Page palettes
      </h2>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        A page palette is authored content identity; light/dark is the
        visitor's appearance preference. Components keep using the semantic
        roles above, while a palette remaps their structural colours for both
        modes. Status roles retain their semantic families.
      </p>
      <DataTable label="Available page palettes">
        <thead>
          <tr>
            <th scope="col">Palette</th>
            <th scope="col">Frontmatter</th>
            <th scope="col">Light canvas / title / body</th>
            <th scope="col">Dark canvas / title / body</th>
            <th scope="col">Current use</th>
          </tr>
        </thead>
        <tbody>
          {pagePaletteRows.map((palette) => (
            <tr>
              <td>{palette.name}</td>
              <td><code>palette: {palette.id}</code></td>
              <td class="tabular-nums">{palette.light}</td>
              <td class="tabular-nums">{palette.dark}</td>
              <td>{palette.use}</td>
            </tr>
          ))}
        </tbody>
      </DataTable>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Type scale
      </h2>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        TASA Orbiter carries everything that is read: Regular (400), Medium
        (500), and Semibold (600) for strong emphasis and genuine labels. Size,
        line-height and weight travel inside the role, and tracking is 0 on
        every step, so
        <code>text-heading</code> alone produces finished type and nothing writes
        <code>tracking-*</code>, <code>leading-*</code> or <code>font-*</code>
        at a call site. Size carries the hierarchy at display scale; weight
        takes over once the sizes get close to body.
      </p>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        Display is the exception, and the only one — Violet Sans, a geometric
        face with one weight. It sits on <code>text-display</code> alone.
        Everything below it stays TASA Orbiter, which supplies the complete
        non-display hierarchy without synthesised weights.
      </p>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        Both webfonts have Arial fallbacks calibrated from their own x-height
        and vertical metrics. TASA is preloaded on every route; Violet is
        preloaded only when a page renders the display role.
      </p>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        Five unique sizes carry the whole site: display, title, one shared
        heading, body and meta. The former h2 and h3 steps now share the 20px
        heading role; semantic structure and spacing distinguish their level.
        Meta remains 14px for captions and compact interface text. Long-form
        reading is a treatment on 16px body, with secondary colour and 1.4
        leading rather than another size.
      </p>
      <Stack gap="md">
        {typeScale.map((t) => (
          <div>
            <p class={t.class}>{t.sample}</p>
            <p class="mt-3xs text-meta tabular-nums text-muted-foreground">
              text-{t.name} · {t.size} · {t.weight}
            </p>
          </div>
        ))}
      </Stack>
      <div class="mt-xl border border-border p-card">
        <Stack gap="sm">
          <p class="text-title">Sample Case Study</p>
          <p class="type-reading max-w-measure">
            Titles carry the hierarchy; reading text stays quieter and more
            compact without introducing another font size.
          </p>
          <div>
            <h2 class="text-heading">Section heading</h2>
            <p class="type-reading max-w-measure">
              A semantic h2 and h3 can share one visual role. Space and document
              structure explain their relationship.
            </p>
            <h3 class="mt-lg text-heading">Nested heading</h3>
          </div>
        </Stack>
      </div>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Spacing
      </h2>
      <p class="mb-md text-meta text-muted-foreground">
        4px base scale, plus semantic roles a brief can name directly.
      </p>
      <Stack gap="2xs">
        {spacingScale.map((s) => (
          <Cluster gap="sm">
            <span class="w-20 shrink-0 text-meta tabular-nums text-muted-foreground">{s.name}</span>
            <span class="h-4 bg-accent" style={`width: ${s.value}`}></span>
            <span class="text-meta tabular-nums text-muted-foreground">{s.px}</span>
          </Cluster>
        ))}
      </Stack>
      <Grid class="mt-md">
        {semanticSpacing.map((s) => (
          <GridItem spanMd={12}>
            <p class="text-meta text-muted-foreground">--spacing-{s.name} → {s.value}</p>
          </GridItem>
        ))}
      </Grid>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Layout primitives
      </h2>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        Pages compose <code>Section &gt; Container &gt; Stack | Grid + GridItem | Cluster</code>
        and never inline layout. The structural grid has 24 tracks and one 10px
        gutter. Items are full-width on phones, then opt into named tablet and
        desktop fractions. <code>Sidebar</code> uses the same math for a 4 / 20
        case-study split and collapses below its measured 56rem boundary.
      </p>
      <Stack gap="md">
        <div>
          <p class="mb-2xs text-meta text-muted-foreground">24 tracks</p>
          <Grid class="grid-specimen" aria-hidden="true">
            {Array.from({ length: 24 }).map(() => <span class="grid-specimen__track"></span>)}
          </Grid>
        </div>

        <Grid class="grid-specimen">
          <GridItem spanLg={8} class="grid-specimen__item">8 columns</GridItem>
          <GridItem spanLg={16} class="grid-specimen__item">16 columns</GridItem>
        </Grid>

        <Grid class="grid-specimen">
          <GridItem spanMd={12} class="grid-specimen__item">12 columns</GridItem>
          <GridItem spanMd={12} class="grid-specimen__item">12 columns</GridItem>
        </Grid>

        <Grid class="grid-specimen">
          <GridItem spanMd={12} spanLg={8} class="grid-specimen__item">8 columns</GridItem>
          <GridItem spanMd={12} spanLg={8} class="grid-specimen__item">8 columns</GridItem>
          <GridItem spanMd={12} spanLg={8} class="grid-specimen__item">8 columns</GridItem>
        </Grid>

        <Grid class="grid-specimen">
          <GridItem spanMd={12} spanLg={6} class="grid-specimen__item">6 columns</GridItem>
          <GridItem spanMd={12} spanLg={6} class="grid-specimen__item">6 columns</GridItem>
          <GridItem spanMd={12} spanLg={6} class="grid-specimen__item">6 columns</GridItem>
          <GridItem spanMd={12} spanLg={6} class="grid-specimen__item">6 columns</GridItem>
        </Grid>

        <Grid class="grid-specimen">
          <GridItem class="grid-specimen__item">24 columns</GridItem>
        </Grid>
      </Stack>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Containers
      </h2>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        One page container, used by the header, the footer and every page, so
        everything sits on the same two vertical edges. <code>Container</code>
        has no size prop. <code>max-w-measure</code> is not a container — it
        is the reading measure (~70 characters) for long-form text and lead
        paragraphs, and it must never be collapsed into the page width.
      </p>
      <Stack gap="2xs">
        {containers.map((c) => (
          <div>
            <div class="h-3 bg-muted" style={`max-width: ${c.value}; width: 100%`}></div>
            <p class="mt-3xs text-meta tabular-nums text-muted-foreground">max-w-{c.name} · {c.value} ({c.px})</p>
          </div>
        ))}
      </Stack>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-md">
        Surfaces
      </h2>
      <Grid>
        <GridItem spanMd={12}>
          <div class="border border-border bg-card p-md">
            <p class="label">Card surface</p>
            <p class="mt-3xs text-meta text-muted-foreground">bg-card with border-border</p>
          </div>
        </GridItem>
        <GridItem spanMd={12}>
          <div class="bg-muted p-md">
            <p class="label">Muted surface</p>
            <p class="mt-3xs text-meta text-muted-foreground">bg-muted, no border</p>
          </div>
        </GridItem>
      </Grid>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Buttons
      </h2>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        Three variants, one base. They are levels of emphasis, not shapes:
        <code>.btn--primary</code> is the one action a page is for and there
        should be at most one per view; <code>.btn--secondary</code> is the
        bordered default for navigation and everything that is an action but
        not <em>the</em> action; <code>.btn--link</code> is an action inside or
        beside a run of text, with no box. Markdown links in a case study get
        the link variant automatically through <code>.prose a</code>.
      </p>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        Always write both classes — <code>btn</code> alone is a transparent
        box with inherited text, which looks close enough to plain markup to
        ship unnoticed. <code>pnpm check</code> fails on a missing variant.
      </p>
      <Cluster gap="sm" class="mb-md">
        <a href="/style-guide" class="btn btn--primary">
          Primary
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/style-guide" class="btn btn--secondary">
          Secondary
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/style-guide" class="btn btn--link">Hyperlink</a>
      </Cluster>
      <DataTable label="Button variants">
        <thead>
          <tr>
            <th scope="col">Variant</th>
            <th scope="col">Rest</th>
            <th scope="col">Hover</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>primary</td>
            <td>background-alternate on text-alternate</td>
            <td>background-alternate-hover</td>
          </tr>
          <tr>
            <td>secondary</td>
            <td>border-primary, text-primary, no fill</td>
            <td>border-hover, background-hover, accent</td>
          </tr>
          <tr>
            <td>link</td>
            <td>text-primary, underlined, no box</td>
            <td>accent</td>
          </tr>
        </tbody>
      </DataTable>
    </Section>

    <Section size="standard" class="border-t border-border">
      <h2 class="label mb-2xs">
        Tables
      </h2>
      <p class="mb-md max-w-measure text-meta text-muted-foreground">
        One treatment for every table: full grid, header cells in the
        <code>.label</code> style, padding from the spacing scale, tabular
        figures. Component tables use <code>DataTable.astro</code>, which adds
        the horizontal-scroll container; markdown tables in a case study get
        the same rules through <code>.prose table</code> and need nothing
        added. A table's columns are its meaning, so it scrolls inside its own
        box rather than reflowing.
      </p>
      <DataTable label="Table specimen">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Value</th>
            <th scope="col">Applies to</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Cell padding</td>
            <td>8px 12px</td>
            <td>th and td</td>
          </tr>
          <tr>
            <td>Rule</td>
            <td>1px border</td>
            <td>Every cell, plus the outer edge</td>
          </tr>
          <tr>
            <td>Header</td>
            <td>14px, 600, uppercase</td>
            <td>th only</td>
          </tr>
        </tbody>
      </DataTable>
    </Section>
    </Container>
  </Section>
</PageLayout>

<script>
  /*
    Fills each primitive swatch's caption with the colour the stylesheet
    actually resolved, rather than a hex literal copied into this file.

    The copies were the problem: 39 of them, hand-maintained, in the page whose
    job is to document the source of truth. Nothing checked them, so this page
    could show one colour while the site rendered another and look correct
    doing it. Reading the computed value means the caption is wrong only if the
    swatch beside it is wrong too.
  */
  const root = getComputedStyle(document.documentElement);
  for (const el of document.querySelectorAll<HTMLElement>("[data-swatch-value]")) {
    const raw = root.getPropertyValue(el.dataset.swatchValue!).trim();
    /* The build minifies #000000 to #000, so some values can arrive
       three digits wide and the caption column would carry two formats. */
    el.textContent = raw.replace(/^#([\da-f])([\da-f])([\da-f])$/i, "#$1$1$2$2$3$3") || "—";
  }
</script>
