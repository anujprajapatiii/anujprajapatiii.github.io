    name: "Neutral",
    swatches: [
      { name: "black", value: "#000000" },
      { name: "900", value: "#0e0f12" },
      { name: "800", value: "#141619" },
      { name: "700", value: "#1c1f24" },
      { name: "600", value: "#21252b" },
      { name: "500", value: "#2c323a" },
      { name: "400", value: "#434b56" },
      { name: "300", value: "#99a1ac" },
      { name: "200", value: "#d3d7dd" },
      { name: "100", value: "#f6f7f8" },
      { name: "white", value: "#ffffff" },
    ],
  },
  {
    name: "Brown",
    swatches: [
      { name: "600", value: "#2e2d2c" },
      { name: "500", value: "#302f2e" },
      { name: "400", value: "#595551" },
      { name: "300", value: "#847b73" },
      { name: "200", value: "#aba199" },
      { name: "100", value: "#cfc7c1" },
      { name: "50", value: "#f1eeec" },
    ],
  },
  {
    name: "Amber",
    swatches: [
      { name: "400", value: "#7c370e" },
      { name: "300", value: "#e66c24" },
      { name: "200", value: "#ee9a68" },
      { name: "100", value: "#f5c2a3" },
    ],
  },
  {
    name: "Blue",
    swatches: [
      { name: "600", value: "#002c83" },
      { name: "500", value: "#1841ac" },
      { name: "400", value: "#1e50d3" },
      { name: "300", value: "#99b6ff" },
      { name: "200", value: "#dae5ff" },
      { name: "100", value: "#f0f3ff" },
    ],
  },
  {
    name: "Green",
    swatches: [
      { name: "400", value: "#1a4723" },
      { name: "300", value: "#37954a" },
      { name: "200", value: "#53c069" },
      { name: "100", value: "#b4e4be" },
    ],
  },
  {
    name: "Red",
    swatches: [
      { name: "400", value: "#67090a" },
      { name: "300", value: "#ec2426" },
      { name: "200", value: "#f2696a" },
      { name: "100", value: "#f7a1a2" },
    ],
  },
  {
    name: "Yellow",
    swatches: [
      { name: "600", value: "#853e0f" },
      { name: "500", value: "#d17600" },
      { name: "400", value: "#ffb700" },
      { name: "300", value: "#ffd293" },
      { name: "200", value: "#ffe9d0" },
      { name: "100", value: "#fff5f5" },
    ],
  },
];

const semanticGroups = [
  {
    name: "Background",
    tokens: [
      { name: "background-primary", light: "neutral-100", dark: "neutral-800" },
      { name: "background-secondary", light: "neutral-200", dark: "neutral-600" },
      { name: "background-tertiary", light: "yellow-500", dark: "yellow-500" },
      { name: "background-alternate", light: "neutral-800", dark: "neutral-100" },
      { name: "background-success", light: "green-100", dark: "green-100" },
      { name: "background-warning", light: "yellow-200", dark: "yellow-200" },
      { name: "background-error", light: "red-100", dark: "red-100" },
      { name: "background-hover", light: "neutral-200", dark: "neutral-600" },
      { name: "background-elevated", light: "white", dark: "neutral-700" },
    ],
  },
  {
    name: "Border",
    tokens: [
      { name: "border-primary", light: "neutral-300", dark: "neutral-500" },
      { name: "border-secondary", light: "brown-200", dark: "brown-400" },
      { name: "border-alternate", light: "neutral-500", dark: "neutral-300" },
      { name: "border-hover", light: "neutral-800", dark: "neutral-100" },
    ],
  },
  {
    name: "Text",
    tokens: [
      { name: "text-primary", light: "neutral-600", dark: "neutral-200" },
      { name: "text-secondary", light: "brown-400", dark: "brown-200" },
      { name: "text-alternate", light: "neutral-100", dark: "neutral-800" },
      { name: "text-success", light: "green-400", dark: "green-400" },
      { name: "text-warning", light: "yellow-600", dark: "yellow-600" },
      { name: "text-error", light: "red-400", dark: "red-400" },
    ],
  },
  {
    name: "Link",
    tokens: [
      { name: "link-primary", light: "text-primary", dark: "text-primary" },
      { name: "link-secondary", light: "neutral-800", dark: "neutral-100" },
      { name: "link-alternate", light: "neutral-100", dark: "neutral-800" },
    ],
  },
];

const typeScale = [
  { name: "display", class: "text-display", size: "clamp(40px → 72px)", weight: "Buch 400", sample: "Display" },
  { name: "h1", class: "text-h1", size: "clamp(32px → 44px)", weight: "Buch 400", sample: "Heading 1" },
  { name: "h2", class: "text-h2", size: "clamp(24px → 30px)", weight: "Halbfett 600", sample: "Heading 2" },
  { name: "h3", class: "text-h3", size: "20px", weight: "Halbfett 600", sample: "Heading 3" },
  { name: "lead", class: "text-lead", size: "18px", weight: "Buch 400", sample: "Lead paragraph" },
  { name: "body", class: "text-body", size: "16px", weight: "Buch 400", sample: "Body text. The quick brown fox jumps over the lazy dog." },
  { name: "small", class: "text-small", size: "14px", weight: "Buch 400", sample: "Small / secondary text" },
  { name: "label", class: "text-label", size: "12px", weight: "Buch 400", sample: "Caption / value text" },
];

const spacingScale = [
  { name: "3xs", value: "0.25rem", px: "4px" },
  { name: "2xs", value: "0.5rem", px: "8px" },
  { name: "xs", value: "0.75rem", px: "12px" },
  { name: "sm", value: "1rem", px: "16px" },
  { name: "md", value: "1.5rem", px: "24px" },
  { name: "lg", value: "2rem", px: "32px" },
  { name: "xl", value: "3rem", px: "48px" },
  { name: "2xl", value: "4rem", px: "64px" },
  { name: "3xl", value: "6rem", px: "96px" },
  { name: "4xl", value: "8rem", px: "128px" },
];

const semanticSpacing = [
  { name: "gutter", value: "24px — page side padding" },
  { name: "section", value: "clamp(48px → 96px) — section rhythm" },
  { name: "stack", value: "16px — gap between stacked elements" },
  { name: "card", value: "24px — card interior padding" },
  { name: "grid", value: "16px — gap between cards" },
];

const containers = [
  { name: "narrow", value: "36rem", px: "576px" },
  { name: "content", value: "48rem", px: "768px" },
  { name: "wide", value: "80rem", px: "1280px" },
];

const aliases = [
  { name: "background", to: "background-primary" },
  { name: "foreground", to: "text-primary" },
  { name: "card", to: "background-elevated" },
  { name: "muted", to: "background-secondary" },
  { name: "muted-foreground", to: "text-secondary" },
  { name: "accent", to: "text-secondary" },
  { name: "border / input", to: "border-primary" },
  { name: "ring", to: "border-hover" },
  { name: "primary", to: "background-alternate" },
  { name: "destructive", to: "text-error" },
];
---

<PageLayout title="Style Guide — Anuj Prajapati" description="Internal design-system reference." noindex>
  <div class="mx-auto max-w-content px-6 pt-12 pb-24 sm:pt-20">
    <h1 class="mb-2 text-h1">Style guide</h1>
    <p class="mb-12 text-muted-foreground">
      Internal reference for the token system — the source of truth is
      <code>src/styles/global.css</code>. Toggle dark mode in the header to
      check both themes. Update this page whenever tokens change.
    </p>

    <section class="border-t border-border py-10">
      <h2 class="label mb-2">
        Primitives
      </h2>
      <p class="mb-6 text-small text-muted-foreground">
        Raw palette. Same values in both themes; components never use these directly.
      </p>
      <div class="flex flex-col gap-6">
        {primitiveFamilies.map((family) => (
          <div>
            <p class="mb-2 text-small font-semibold">{family.name}</p>
            <div class="flex flex-wrap gap-2">
              {family.swatches.map((swatch) => (
                <div class="w-16">
                  <div
                    class="h-10 rounded-md border border-border"
                    style={`background: ${swatch.value}`}
                  ></div>
                  <p class="mt-1 text-label tabular-nums text-muted-foreground">
                    {swatch.name}<br />{swatch.value}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-10">
      <h2 class="label mb-2">
        Semantic tokens
      </h2>
      <p class="mb-6 text-small text-muted-foreground">
        Semantic role names. The swatch shows the token in the theme you're
        viewing; the caption lists its light → dark primitive mapping.
      </p>
      <div class="flex flex-col gap-8">
        {semanticGroups.map((group) => (
          <div>
            <p class="mb-2 text-small font-semibold">{group.name}</p>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
              {group.tokens.map((token) => (
                <div class="rounded-lg border border-border p-3">
                  <div
                    class="h-12 rounded-md border border-border"
                    style={`background: var(--${token.name})`}
                  ></div>
                  <p class="mt-2 text-label">--{token.name}</p>
                  <p class="text-label tabular-nums text-muted-foreground">
                    {token.light} → {token.dark}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-10">
      <h2 class="label mb-2">
        Aliases
      </h2>
      <p class="mb-6 text-small text-muted-foreground">
        Internal names the components use, pointed at the semantic tokens above.
      </p>
      <div class="grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2">
        {aliases.map((alias) => (
          <p class="text-label text-muted-foreground">
            --{alias.name} → {alias.to}
          </p>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-10">
      <h2 class="label mb-2">
        Type scale
      </h2>
      <p class="mb-6 max-w-narrow text-small text-muted-foreground">
        One font — Söhne, in two weights: Buch (400) and Halbfett (600). Size,
        line-height, tracking and weight all travel inside the token, so
        <code>text-h2</code> alone produces finished type and nothing writes
        <code>tracking-*</code>, <code>leading-*</code> or <code>font-*</code>
        at a call site. Size carries the hierarchy at display scale; weight
        takes over once the sizes get close to body.
      </p>
      <div class="flex flex-col gap-5">
        {typeScale.map((t) => (
          <div>
            <p class={t.class}>{t.sample}</p>
            <p class="mt-1 text-label tabular-nums text-muted-foreground">
              text-{t.name} · {t.size} · {t.weight}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-10">
      <h2 class="label mb-2">
        Spacing
      </h2>
      <p class="mb-6 text-small text-muted-foreground">
        4px base scale, plus semantic roles a brief can name directly.
      </p>
      <div class="flex flex-col gap-2">
        {spacingScale.map((s) => (
          <div class="flex items-center gap-4">
            <span class="w-20 shrink-0 text-label tabular-nums text-muted-foreground">{s.name}</span>
            <span class="h-4 rounded-sm bg-accent" style={`width: ${s.value}`}></span>
            <span class="text-label tabular-nums text-muted-foreground">{s.px}</span>
          </div>
        ))}
      </div>
      <div class="mt-6 grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2">
        {semanticSpacing.map((s) => (
          <p class="text-label text-muted-foreground">--spacing-{s.name} → {s.value}</p>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-10">
      <h2 class="label mb-2">
        Containers
      </h2>
      <p class="mb-6 text-small text-muted-foreground">
        Max content widths. Use <code>max-w-wide</code> for the homepage and
        project grids, <code>max-w-content</code> for case-study bodies.
      </p>
      <div class="flex flex-col gap-2">
        {containers.map((c) => (
          <div>
            <div class="h-3 rounded-sm bg-muted" style={`max-width: ${c.value}; width: 100%`}></div>
            <p class="mt-1 text-label tabular-nums text-muted-foreground">max-w-{c.name} · {c.value} ({c.px})</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-10">
      <h2 class="label mb-6">
        Surfaces
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-semibold">Card surface</p>
          <p class="mt-1 text-small text-muted-foreground">bg-card with border-border</p>
        </div>
        <div class="rounded-xl bg-muted p-6">
          <p class="font-semibold">Muted surface</p>
          <p class="mt-1 text-small text-muted-foreground">bg-muted, no border</p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>
