---
import PageLayout from "@/layouts/PageLayout.astro";
import ActionLink from "@/components/ActionLink.astro";
import DataTable from "@/components/DataTable.astro";
import OnThisPage from "@/components/OnThisPage.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TabsSpecimen from "@/components/TabsSpecimen";
import SectionHeading from "@/components/SectionHeading.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Container from "@/components/primitives/Container.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import Section from "@/components/primitives/Section.astro";
import Sidebar from "@/components/primitives/Sidebar.astro";
import Stack from "@/components/primitives/Stack.astro";
import {
  aliases,
  containers,
  coreColourRoles,
  interactionFoundations,
  pagePaletteRows,
  primitiveFamilies,
  semanticGroups,
  semanticSpacing,
  spacingScale,
  styleGuideChapters,
  styleGuideHeadings,
  typeScale,
} from "@/data/style-guide";
import "@/components/style-guide/style-guide.css";
---

<PageLayout
  title="Style Guide — Anuj Prajapati"
  description="Internal design-system reference."
  noindex
>
  <Section size="page">
    <Container>
      <Stack gap="2xl">
        <header class="style-guide-intro">
          <Stack gap="lg">
            <Stack gap="sm">
              <h1 class="text-title">Style guide</h1>
              <p class="max-w-measure text-muted-foreground">
                A working reference for the portfolio’s foundations, layout,
                and shared components. Start with the decision you need; open
                the exhaustive token catalogs only when implementation detail
                matters.
              </p>
            </Stack>

            <nav aria-label="Style guide chapters">
              <Grid>
                {styleGuideChapters.map((chapter) => (
                  <GridItem span={12} spanMd={12} spanLg={6}>
                    <a class="style-guide-chapter-link" href={`#${chapter.slug}`}>
                      <span class="label">{chapter.index}</span>
                      <span class="style-guide-chapter-link__title text-heading">
                        {chapter.title}
                      </span>
                      <span class="style-guide-chapter-link__description text-muted-foreground">
                        {chapter.description}
                      </span>
                    </a>
                  </GridItem>
                ))}
              </Grid>
            </nav>
          </Stack>
        </header>

        <Sidebar>
          <OnThisPage items={styleGuideHeadings} />

          <div class="style-guide-content">
            <Stack gap="2xl">
              <section class="style-guide-chapter" aria-labelledby="foundations">
                <Stack gap="xl">
                  <header class="style-guide-chapter__header">
                    <SectionHeading id="foundations">Foundations</SectionHeading>
                    <p class="max-w-measure text-muted-foreground">
                      The small set of decisions every interface inherits before
                      component styling begins.
                    </p>
                  </header>

                  <section class="style-guide-topic" aria-labelledby="colour">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="colour" class="text-heading">Colour system</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Components use semantic roles, never primitive colours.
                          Appearance mode remaps those roles without changing
                          component code.
                        </p>
                      </header>

                      <div>
                        <p class="label mb-2xs">Core roles</p>
                        <Grid>
                          {coreColourRoles.map((role) => (
                            <GridItem span={24} spanMd={8}>
                              <div class="style-guide-role">
                                <span
                                  class="style-guide-role__sample"
                                  style={`--style-guide-role: var(--${role.name})`}
                                  aria-hidden="true"
                                ></span>
                                <span>
                                  <span class="style-guide-role__label">{role.label}</span>
                                  <code>--{role.name}</code>
                                </span>
                              </div>
                            </GridItem>
                          ))}
                        </Grid>
                      </div>

                      <p class="max-w-measure text-muted-foreground">
                        The complete primitive palette, canonical semantic roles,
                        page palettes, and compatibility aliases live in
                        <ActionLink href="#reference" variant="link">Reference</ActionLink>.
                      </p>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="typography">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="typography" class="text-heading">Typography</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Four sizes carry the system. Regular carries display,
                          title, and body; Medium separates headings and genuine
                          labels. Tracking stays at zero.
                        </p>
                      </header>

                      <Stack gap="md">
                        {typeScale.map((type) => (
                          <div class="style-guide-type-specimen">
                            <p class={type.class}>{type.sample}</p>
                            <p class="text-body tabular-nums text-muted-foreground">
                              text-{type.name} · {type.size} · {type.weight}
                            </p>
                          </div>
                        ))}
                      </Stack>

                      <div class="style-guide-reading-specimen">
                        <Stack gap="sm">
                          <p class="text-title">Sample Case Study</p>
                          <p class="type-reading max-w-measure">
                            Titles carry hierarchy. Reading text uses secondary
                            colour and a tighter reading leading without creating
                            another font size.
                          </p>
                          <div>
                            <p class="text-heading">Section heading</p>
                            <p class="type-reading max-w-measure">
                              Semantic h2 and h3 elements can share this visual
                              role; document structure and space explain their
                              relationship.
                            </p>
                          </div>
                        </Stack>
                      </div>

                      <details class="style-guide-disclosure">
                        <summary>
                          <span>Font implementation</span>
                          <span class="style-guide-disclosure__meta">Reference note</span>
                        </summary>
                        <div class="style-guide-disclosure__body">
                          <Stack gap="sm">
                            <p class="max-w-measure text-muted-foreground">
                              KMR Apparat is self-hosted from the original Kimera
                              WOFF2 files. Regular and Medium serve the shared
                              roles; Light is approved but currently unassigned.
                            </p>
                            <p class="max-w-measure text-muted-foreground">
                              Role tokens own size, leading, and weight. Call
                              sites never add tracking, leading, or weight
                              utilities, and the browser does not synthesize
                              missing cuts.
                            </p>
                          </Stack>
                        </div>
                      </details>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="spacing">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="spacing" class="text-heading">Spacing</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Content rhythm follows a 4px base scale. Structural
                          roles name page geometry separately from component
                          spacing.
                        </p>
                      </header>

                      <div class="style-guide-spacing-scale">
                        {spacingScale.map((space) => (
                          <div class="style-guide-spacing-row">
                            <code>{space.name}</code>
                            <span
                              class="style-guide-spacing-bar"
                              style={`--style-guide-size: ${space.value}`}
                              aria-hidden="true"
                            ></span>
                            <span class="tabular-nums text-muted-foreground">
                              {space.value} · {space.px}
                            </span>
                          </div>
                        ))}
                      </div>

                      <DataTable label="Semantic spacing roles" pinFirstColumn>
                        <thead>
                          <tr>
                            <th scope="col">Role</th>
                            <th scope="col">Value and use</th>
                          </tr>
                        </thead>
                        <tbody>
                          {semanticSpacing.map((space) => (
                            <tr>
                              <th scope="row"><code>--spacing-{space.name}</code></th>
                              <td>{space.value}</td>
                            </tr>
                          ))}
                        </tbody>
                      </DataTable>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="surfaces">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="surfaces" class="text-heading">Surfaces and interaction</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Tone carries depth: canvas, inset, raised, then raised
                          hover. A fixed top-left light adds crisp one-pixel edge
                          definition to selected interactive surfaces.
                        </p>
                      </header>

                      <div class="style-guide-surface-canvas">
                        <p class="label mb-sm">Canvas</p>
                        <Grid>
                          <GridItem spanMd={12}>
                            <div class="style-guide-surface light-shade-specimen--raised">
                              <p class="label">Raised</p>
                              <p class="text-muted-foreground">Card rest</p>
                              <div class="style-guide-surface__inset">
                                <p class="label">Inset</p>
                                <p class="text-muted-foreground">Media and recessed content</p>
                              </div>
                            </div>
                          </GridItem>
                          <GridItem spanMd={12}>
                            <div class="style-guide-surface style-guide-surface--hover light-shade-specimen--hover">
                              <p class="label">Raised hover</p>
                              <p class="text-muted-foreground">One tonal step forward</p>
                              <div class="style-guide-surface__inset">
                                <p class="label">Inset</p>
                                <p class="text-muted-foreground">Still distinct from its parent</p>
                              </div>
                            </div>
                          </GridItem>
                        </Grid>
                      </div>

                      <Grid>
                        {interactionFoundations.map((foundation) => (
                          <GridItem spanMd={12} spanLg={8}>
                            <article class="style-guide-foundation-card">
                              <p class="label">{foundation.name}</p>
                              <p class="style-guide-foundation-card__description text-muted-foreground">
                                {foundation.description}
                              </p>
                              <dl class="style-guide-definition-list">
                                {foundation.rows.map((row) => (
                                  <div>
                                    <dt><code>{row.token}</code></dt>
                                    <dd>{row.value}</dd>
                                  </div>
                                ))}
                              </dl>
                            </article>
                          </GridItem>
                        ))}
                      </Grid>

                      <div>
                        <p class="label mb-sm">Live raised surface</p>
                        <Grid>
                          <GridItem spanMd={12}>
                            <ProjectCard
                              id="sample-case-study"
                              title="Project card"
                              description="Raised surface with inset media and one whole-card link."
                              headingLevel="h4"
                            />
                          </GridItem>
                        </Grid>
                      </div>
                    </Stack>
                  </section>
                </Stack>
              </section>

              <section class="style-guide-chapter" aria-labelledby="layout">
                <Stack gap="xl">
                  <header class="style-guide-chapter__header">
                    <SectionHeading id="layout">Layout</SectionHeading>
                    <p class="max-w-measure text-muted-foreground">
                      One page container, one reading measure, and one structural
                      grid keep every route on the same geometry.
                    </p>
                  </header>

                  <section class="style-guide-topic" aria-labelledby="composition">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="composition" class="text-heading">Composition</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Pages compose <code>Section &gt; Container &gt; Stack | Grid + GridItem | Cluster</code>.
                          The grid has 24 tracks and a 10px gutter; items begin
                          full width, then opt into named fractions.
                        </p>
                      </header>

                      <Stack gap="md">
                        <div>
                          <p class="label mb-2xs">24 tracks</p>
                          <Grid class="grid-specimen" aria-hidden="true">
                            {Array.from({ length: 24 }).map(() => (
                              <span class="grid-specimen__track"></span>
                            ))}
                          </Grid>
                        </div>

                        <Grid class="grid-specimen">
                          <GridItem spanLg={8} class="grid-specimen__item">8 columns</GridItem>
                          <GridItem spanLg={16} class="grid-specimen__item">16 columns</GridItem>
                        </Grid>
                        <Grid class="grid-specimen">
                          <GridItem spanMd={12} class="grid-specimen__item">12 columns</GridItem>
                          <GridItem spanMd={12} class="grid-specimen__item">12 columns</GridItem>
                        </Grid>
                        <Grid class="grid-specimen">
                          <GridItem spanMd={12} spanLg={8} class="grid-specimen__item">8 columns</GridItem>
                          <GridItem spanMd={12} spanLg={8} class="grid-specimen__item">8 columns</GridItem>
                          <GridItem spanMd={12} spanLg={8} class="grid-specimen__item">8 columns</GridItem>
                        </Grid>
                      </Stack>

                      <div>
                        <p class="label mb-2xs">Container roles</p>
                        <Stack gap="sm">
                          {containers.map((container) => (
                            <div class="style-guide-container-specimen">
                              <span
                                class="style-guide-container-specimen__bar"
                                style={`--style-guide-container: ${container.value}`}
                                aria-hidden="true"
                              ></span>
                              <p class="tabular-nums text-muted-foreground">
                                <code>--container-{container.name}</code> · {container.value} · {container.description}
                              </p>
                            </div>
                          ))}
                        </Stack>
                      </div>

                      <p class="max-w-measure text-muted-foreground">
                        <code>Sidebar</code> uses the same grid for a 4 / 20
                        content split and collapses below its measured 56rem
                        boundary. This page’s desktop directory is the live
                        specimen.
                      </p>
                    </Stack>
                  </section>
                </Stack>
              </section>

              <section class="style-guide-chapter" aria-labelledby="components">
                <Stack gap="xl">
                  <header class="style-guide-chapter__header">
                    <SectionHeading id="components">Components</SectionHeading>
                    <p class="max-w-measure text-muted-foreground">
                      Shared patterns shown in their real states and with their
                      implementation contracts close at hand.
                    </p>
                  </header>

                  <section class="style-guide-topic" aria-labelledby="actions">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="actions" class="text-heading">Actions</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Primary names the action a region is for. Secondary is
                          the bordered default; link belongs inside or beside
                          running text. React commands share the same roles.
                        </p>
                      </header>

                      <Cluster gap="sm">
                        <ActionLink href="#actions" variant="primary">
                          Primary action
                        </ActionLink>
                        <ActionLink href="#actions">
                          Secondary action
                        </ActionLink>
                        <ActionLink href="#actions" variant="link">Inline action</ActionLink>
                      </Cluster>

                      <DataTable label="Action variants" pinFirstColumn>
                        <thead>
                          <tr>
                            <th scope="col">Variant</th>
                            <th scope="col">Use</th>
                            <th scope="col">State model</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <th scope="row">Primary</th>
                            <td>One defining action per region</td>
                            <td>Filled rest, hover, and pressed surfaces</td>
                          </tr>
                          <tr>
                            <th scope="row">Secondary</th>
                            <td>Supporting or navigational action</td>
                            <td>Transparent rest; surface and border strengthen</td>
                          </tr>
                          <tr>
                            <th scope="row">Link</th>
                            <td>Action in or beside text</td>
                            <td>Underlined, wrapping, and boxless</td>
                          </tr>
                        </tbody>
                      </DataTable>

                      <details class="style-guide-disclosure">
                        <summary>
                          <span>Theme shortcut keycap</span>
                          <span class="style-guide-disclosure__meta">Nested affordance</span>
                        </summary>
                        <div class="style-guide-disclosure__body">
                          <Stack gap="sm">
                            <p class="max-w-measure text-muted-foreground">
                              The keycap is a shortcut hint inside the theme
                              toggle’s one action, not a standalone button.
                            </p>
                            <DataTable label="Theme shortcut keycap states">
                              <thead>
                                <tr>
                                  <th scope="col">State</th>
                                  <th scope="col">Effect</th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr><td>Rest</td><td>Raised</td></tr>
                                <tr><td>Hover or keyboard focus</td><td>Raised hover</td></tr>
                                <tr><td>Pointer or physical key press</td><td>Pressed</td></tr>
                              </tbody>
                            </DataTable>
                          </Stack>
                        </div>
                      </details>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="tables">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="tables" class="text-heading">Tables</h3>
                        <p class="max-w-measure text-muted-foreground">
                          One quiet-ledger treatment: strong outer and header
                          rules, quiet row separators, no vertical walls, and
                          tabular figures. Wide tables scroll inside their own
                          labelled region rather than reflowing.
                        </p>
                      </header>

                      <DataTable label="Table specimen" pinFirstColumn>
                        <thead>
                          <tr>
                            <th scope="col">Token</th>
                            <th scope="col">Value</th>
                            <th scope="col">Applies to</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <th scope="row">Cell padding</th>
                            <td>8px 12px</td>
                            <td>Header and value cells</td>
                          </tr>
                          <tr>
                            <th scope="row">Rule</th>
                            <td>1px horizontal</td>
                            <td>Outer block, column header, and rows</td>
                          </tr>
                          <tr>
                            <th scope="row">Column header</th>
                            <td>14px, 500, uppercase</td>
                            <td><code>thead th</code></td>
                          </tr>
                          <tr>
                            <th scope="row">Row header</th>
                            <td>14px, 500, natural case</td>
                            <td><code>tbody th</code></td>
                          </tr>
                        </tbody>
                      </DataTable>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="tabs">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="tabs" class="text-heading">Tabs</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Line and Contained tabs share one accessible behaviour
                          contract. Use them for a small set of peer content
                          views shown one at a time.
                        </p>
                      </header>
                      <TabsSpecimen client:visible />
                    </Stack>
                  </section>
                </Stack>
              </section>

              <section class="style-guide-chapter" aria-labelledby="reference">
                <Stack gap="xl">
                  <header class="style-guide-chapter__header">
                    <SectionHeading id="reference">Reference</SectionHeading>
                    <p class="max-w-measure text-muted-foreground">
                      Exhaustive implementation detail. These catalogs remain
                      complete, but stay out of the main reading path until
                      they are needed.
                    </p>
                  </header>

                  <section class="style-guide-topic" aria-labelledby="page-palettes">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="page-palettes" class="text-heading">Page palettes</h3>
                        <p class="max-w-measure text-muted-foreground">
                          An authored page palette is separate from the visitor’s
                          light or dark appearance. The infrastructure remains
                          available even when no published content opts in.
                        </p>
                      </header>

                      <DataTable label="Available page palettes" pinFirstColumn>
                        <thead>
                          <tr>
                            <th scope="col">Palette</th>
                            <th scope="col">Appearance mapping</th>
                            <th scope="col">Current use</th>
                          </tr>
                        </thead>
                        <tbody>
                          {pagePaletteRows.map((palette) => (
                            <tr>
                              <th scope="row">
                                {palette.name}<br />
                                <code>palette: {palette.id}</code>
                              </th>
                              <td>
                                <div class="style-guide-palette-mapping">
                                  <p><span class="label">Light</span> {palette.light}</p>
                                  <p><span class="label">Dark</span> {palette.dark}</p>
                                </div>
                              </td>
                              <td>{palette.use}</td>
                            </tr>
                          ))}
                        </tbody>
                      </DataTable>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="primitive-colours">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="primitive-colours" class="text-heading">Primitive colours</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Raw palette values are identical in both appearances.
                          Components never consume them directly.
                        </p>
                      </header>

                      <div class="style-guide-disclosure-list">
                        {primitiveFamilies.map((family) => (
                          <details class="style-guide-disclosure">
                            <summary>
                              <span>{family.name}</span>
                              <span class="style-guide-disclosure__meta">
                                {family.swatches.length} values
                              </span>
                            </summary>
                            <div class="style-guide-disclosure__body">
                              <Cluster gap="2xs" align="start">
                                {family.swatches.map((swatch) => (
                                  <div class="style-guide-primitive">
                                    <span
                                      class="style-guide-primitive__chip"
                                      style={`background: var(--${family.prefix}-${swatch})`}
                                      aria-hidden="true"
                                    ></span>
                                    <p class="tabular-nums text-muted-foreground">
                                      {swatch}<br />
                                      <span data-swatch-value={`--${family.prefix}-${swatch}`}>
                                        CSS value
                                      </span>
                                    </p>
                                  </div>
                                ))}
                              </Cluster>
                            </div>
                          </details>
                        ))}
                      </div>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="semantic-tokens">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="semantic-tokens" class="text-heading">Semantic tokens</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Role names map to different primitives in light and
                          dark appearance. Open only the family you need.
                        </p>
                      </header>

                      <div class="style-guide-disclosure-list">
                        {semanticGroups.map((group) => (
                          <details class="style-guide-disclosure">
                            <summary>
                              <span>{group.name}</span>
                              <span class="style-guide-disclosure__meta">
                                {group.tokens.length} roles
                              </span>
                            </summary>
                            <div class="style-guide-disclosure__body">
                              <Grid>
                                {group.tokens.map((token) => (
                                  <GridItem span={24} spanMd={12} spanLg={8}>
                                    <article class="style-guide-token">
                                      <span
                                        class="style-guide-token__sample"
                                        style={`--style-guide-token: var(--${token.name})`}
                                        aria-hidden="true"
                                      ></span>
                                      <code>--{token.name}</code>
                                      <dl class="style-guide-token__mapping">
                                        <div>
                                          <dt>Light</dt>
                                          <dd>{token.light}</dd>
                                        </div>
                                        <div>
                                          <dt>Dark</dt>
                                          <dd>{token.dark}</dd>
                                        </div>
                                      </dl>
                                    </article>
                                  </GridItem>
                                ))}
                              </Grid>
                            </div>
                          </details>
                        ))}
                      </div>
                    </Stack>
                  </section>

                  <section class="style-guide-topic" aria-labelledby="compatibility-aliases">
                    <Stack gap="md">
                      <header class="style-guide-topic__header">
                        <h3 id="compatibility-aliases" class="text-heading">Compatibility aliases</h3>
                        <p class="max-w-measure text-muted-foreground">
                          Tailwind and shadcn-facing names point to the canonical
                          semantic roles above. They are a bridge, not a second
                          colour system.
                        </p>
                      </header>

                      <DataTable label="Tailwind compatibility aliases" pinFirstColumn>
                        <thead>
                          <tr>
                            <th scope="col">Alias</th>
                            <th scope="col">Canonical role</th>
                          </tr>
                        </thead>
                        <tbody>
                          {aliases.map((alias) => (
                            <tr>
                              <th scope="row"><code>--{alias.name}</code></th>
                              <td><code>--{alias.to}</code></td>
                            </tr>
                          ))}
                        </tbody>
                      </DataTable>

                      <p class="max-w-measure text-muted-foreground">
                        Base tokens live in <code>src/styles/global.css</code>;
                        authored palette remaps live in <code>src/styles/themes/</code>.
                        Update this reference whenever those contracts change.
                      </p>
                    </Stack>
                  </section>
                </Stack>
              </section>
            </Stack>
          </div>
        </Sidebar>
      </Stack>
    </Container>
  </Section>
</PageLayout>

<script>
  /* Primitive captions read the rendered token value from the stylesheet, so
     the visual chip and its label cannot disagree. The fallback text remains
     meaningful if JavaScript is unavailable. */
  const root = getComputedStyle(document.documentElement);
  for (const element of document.querySelectorAll<HTMLElement>("[data-swatch-value]")) {
    const value = root.getPropertyValue(element.dataset.swatchValue!).trim();
    element.textContent =
      value.replace(/^#([\da-f])([\da-f])([\da-f])$/i, "#$1$1$2$2$3$3") ||
      "CSS value";
  }
</script>
