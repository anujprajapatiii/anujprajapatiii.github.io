---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import { getPublishedProjects } from "@/lib/content/queries";

const projects = await getPublishedProjects();
---

<PageLayout title="Work — Anuj Prajapati" description="Selected design work and case studies.">
  <Section size="page">
    <Container>
      <Stack gap="lg">
        <Stack gap="sm">
          <h1 class="text-title">Work</h1>
          <p class="max-w-measure text-body text-muted-foreground">
            Selected projects and case studies.
          </p>
        </Stack>
        <Grid>
          {projects.map((project) => (
            <GridItem spanMd={12} spanLg={8}>
              <ProjectCard
                id={project.id}
                title={project.data.title}
                description={project.data.description}
                thumbnail={project.data.media.thumbnail}
              />
            </GridItem>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>
</PageLayout>
