---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Grid from "@/components/primitives/Grid.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<PageLayout title="Work — Anuj Prajapati" description="Selected design work and case studies.">
  <Section size="page">
    <Container size="content">
      <Stack gap="lg">
        <Stack gap="md">
          <h1 class="text-h1">Work</h1>
          <p class="max-w-narrow text-lead text-muted-foreground">
            Selected projects and case studies.
          </p>
        </Stack>
        <Grid min="280px" gap="md">
          {projects.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              description={project.data.description}
              year={project.data.year}
              thumbnail={project.data.thumbnail}
            />
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>
</PageLayout>
