---
import PageLayout from "@/layouts/PageLayout.astro";
import ActionLink from "@/components/ActionLink.astro";
import EmbedFrame from "@/components/EmbedFrame.astro";
import Section from "@/components/primitives/Section.astro";
import Container from "@/components/primitives/Container.astro";
import Stack from "@/components/primitives/Stack.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Sidebar from "@/components/primitives/Sidebar.astro";
import Grid from "@/components/primitives/Grid.astro";
import GridItem from "@/components/primitives/GridItem.astro";
import OnThisPage from "@/components/OnThisPage.astro";
import DataTable from "@/components/DataTable.astro";
import ThemeImage from "@/components/ThemeImage.astro";
import { getPublishedProjects } from "@/lib/content/queries";
import { render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const publishedYear = project.data.publishedAt.getUTCFullYear();
---

<PageLayout
  title={`${project.data.title} — Anuj Prajapati`}
  description={project.data.description}
  image={project.data.media.hero ?? project.data.media.thumbnail}
  palette={project.data.palette}
>
  <Section as="article" size="page" class="case-study">
    <Stack gap="xl">
      <Container as="header">
        <Grid class="case-study-header-grid">
          <GridItem spanLg={12}>
            <Stack gap="sm">
              <h1 class="text-title">{project.data.title}</h1>
              <p class="type-reading max-w-measure">
                {project.data.description}
              </p>
            </Stack>
          </GridItem>

          <GridItem spanLg={12}>
            <Stack gap="sm">
              <DataTable label="Project details">
                <thead>
                  <tr>
                    {project.data.role && <th scope="col">Role</th>}
                    <th scope="col">Year</th>
                    {project.data.skills.length > 0 && <th scope="col">Skills</th>}
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    {project.data.role && <td>{project.data.role}</td>}
                    <td>{publishedYear}</td>
                    {project.data.skills.length > 0 && <td>{project.data.skills.join(", ")}</td>}
                  </tr>
                </tbody>
              </DataTable>

              {project.data.liveUrl && (
                <Cluster>
                  <ActionLink
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    variant="primary"
                  >
                    Try it live
                    <span aria-hidden="true">&rarr;</span>
                  </ActionLink>
                </Cluster>
              )}
            </Stack>
          </GridItem>
        </Grid>
      </Container>

    {/* Breaks out of the reading column to full width — see EmbedFrame. */}
    {project.data.embedUrl && (
      <EmbedFrame
        url={project.data.embedUrl}
        title={project.data.title}
        onPhone={project.data.embedOnPhone}
      />
    )}

    <Container>
      <Stack gap="lg">
        {/*
          Same rule as Play: an embed is its own hero, so a case study that
          opens with a live tool gets no placeholder above it. No work item
          uses embedUrl today — this keeps the two near-identical templates
          from drifting apart the first time one does.
        */}
        {project.data.media.hero ? (
          <ThemeImage
            lightSrc={project.data.media.hero}
            darkSrc={project.data.media.heroDark}
            alt=""
          />
        ) : (
          !project.data.embedUrl && <div class="media-placeholder"></div>
        )}
        {/* Rail beside the body only: the table of contents belongs to the
            prose it describes, and the header above wants its full width. */}
        <Sidebar>
          <OnThisPage headings={headings} />
          <div class="prose">
            <Content />
          </div>
        </Sidebar>
      </Stack>
    </Container>
    </Stack>
  </Section>
</PageLayout>
